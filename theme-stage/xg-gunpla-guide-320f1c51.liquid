{%- comment -%}
  "What the grade means" + tools for a Gunpla / Pokemon model kit (owner, 2026-09-29: "gunpla
  what the grades mean, show upsell products and things like the liner markers").

  The grade comes from the nightly Gunpla facts (exor.gp_grade_code, chaywrite src/gunpla.js).
  The ladder shows where this kit sits (Entry -> High -> Real -> Master -> Perfect), then a
  plain line on size, build time and who it suits. The figures are the usual ones for each
  grade, worded "about" / "usually": individual kits vary.

  The tools row is filled from the worker's /kit.json?for=gunpla: the in-stock nippers, Gundam
  markers / panel liners, top coat and sanding sticks, each with its own Add button.

  Params: code (exor.gp_grade_code), grade (exor.gp_grade)
{%- endcomment -%}
{%- liquid
  assign c = code | upcase
  assign fam = ''
  case c
    when 'PG UNLEASHED'
      assign fam = 'PGU'
    when 'PG'
      assign fam = 'PG'
    when 'MGEX'
      assign fam = 'MGEX'
    when 'MGSD'
      assign fam = 'MGSD'
    when 'MG'
      assign fam = 'MG'
    when 'RG'
      assign fam = 'RG'
    when 'RE/100'
      assign fam = 'RE'
    when 'HIRM'
      assign fam = 'HIRM'
    when 'FM'
      assign fam = 'FM'
    when 'MEGA SIZE'
      assign fam = 'MEGA'
    when 'EG'
      assign fam = 'EG'
    when 'HAROPLA'
      assign fam = 'HARO'
    when 'BEST MECHA'
      assign fam = 'BMC'
    when 'POKEPLA'
      assign fam = 'POKE'
    when 'SDEX', 'SDCS', 'SDW HEROES', 'SD SANGOKU', 'SDBF', 'BB', 'SD'
      assign fam = 'SD'
  endcase
  if fam == '' and c contains 'HG'
    assign fam = 'HG'
  endif

  comment
    name | scale | size | time | level 1-5 | level word | the line
  endcomment
  case fam
    when 'EG'
      assign g = 'Entry Grade|1/144|about 13 cm|about 1 hour|1|First kit|Made for a first build: the parts twist off the runner by hand and snap together, no tools or glue needed. Nippers still give cleaner edges.'
    when 'HG'
      assign g = 'High Grade|1/144|about 13 cm|2 to 4 hours|2|Beginner|The classic starting grade: a simple snap build with good colour separation and posing. The biggest range of mobile suits is in HG.'
    when 'RG'
      assign g = 'Real Grade|1/144|about 13 cm|6 to 12 hours|4|Experienced|HG size with Master Grade detail: an inner frame, lots of tiny parts and fine panel lines. Rewarding, but fiddly - best after a few HGs.'
    when 'MG'
      assign g = 'Master Grade|1/100|about 18 cm|8 to 15 hours|3|Intermediate|Bigger, with a full inner frame under the armour and much more detail and posing. The usual next step after High Grade.'
    when 'MGEX'
      assign g = 'Master Grade EX|1/100|about 20 cm|20+ hours|4|Advanced|The top of the Master Grade line: extra frame detail, special parts and LED-ready builds for experienced builders.'
    when 'MGSD'
      assign g = 'Master Grade SD|SD|about 10 cm|4 to 6 hours|3|Intermediate|A super-deformed kit built like a Master Grade, with an inner frame and a lot of articulation for its size.'
    when 'PG'
      assign g = 'Perfect Grade|1/60|about 30 cm|20 to 40 hours|5|Expert|The largest and most detailed grade: hundreds of parts, a full inner frame and often lights. A centrepiece build.'
    when 'PGU'
      assign g = 'Perfect Grade Unleashed|1/60|about 30 cm|40+ hours|5|Expert|Perfect Grade rebuilt from the frame out, built in stages. The most involved Gunpla there is.'
    when 'RE'
      assign g = 'Reborn-One Hundred|1/100|about 18 cm|4 to 8 hours|3|Intermediate|Master Grade size without the inner frame, for less common suits. Quicker than an MG with the same big presence.'
    when 'FM'
      assign g = 'Full Mechanics|1/100|about 18 cm|6 to 10 hours|3|Intermediate|1/100 scale with detailed mechanics and armour, but no full inner frame. Between HG and MG in effort.'
    when 'HIRM'
      assign g = 'Hi-Resolution Model|1/100|about 18 cm|10+ hours|4|Advanced|A premium display kit with metal frame parts and pre-finished details.'
    when 'MEGA'
      assign g = 'Mega Size Model|1/48|about 37 cm|6 to 8 hours|2|Beginner|Huge but simple: the build is close to a High Grade, just at nearly three times the size.'
    when 'SD'
      assign g = 'SD Gundam|SD|about 8 to 10 cm|1 to 2 hours|1|First kit|Small, cute super-deformed suits with few parts. A quick, fun build for any age.'
    when 'HARO'
      assign g = 'Haropla|-|about 7 cm|under 1 hour|1|First kit|A little Haro to snap together in one sitting.'
    when 'BMC'
      assign g = 'Best Mecha Collection|1/144|about 13 cm|about 2 hours|2|Beginner|Classic designs reissued as simple snap kits.'
    when 'POKE'
      assign g = 'Pok&eacute;mon Model Kit|-|varies|30 to 90 minutes|1|First kit|Snap-together Pok&eacute;mon: no glue or paint needed and colour-molded parts. Great for kids and first-timers.'
    else
      assign g = ''
  endcase
  assign gp = g | split: '|'
-%}
{%- if g != '' -%}
<section class="xg-gg" aria-label="What this grade means">
  <h3 class="xg-gg__h">What {% if fam == 'POKE' %}this kit{% else %}{{ c | escape }}{% endif %} means</h3>
  {%- unless fam == 'POKE' or fam == 'HARO' or fam == 'BMC' -%}
  <ol class="xg-gg__ladder" aria-label="Gunpla grades from easiest to hardest">
    {%- assign steps = 'EG:Entry|HG:High|RG:Real|MG:Master|PG:Perfect' | split: '|' -%}
    {%- assign here = fam -%}
    {%- if fam == 'MGEX' or fam == 'MGSD' or fam == 'RE' or fam == 'FM' or fam == 'HIRM' -%}{%- assign here = 'MG' -%}{%- endif -%}
    {%- if fam == 'PGU' -%}{%- assign here = 'PG' -%}{%- endif -%}
    {%- if fam == 'MEGA' -%}{%- assign here = 'HG' -%}{%- endif -%}
    {%- if fam == 'SD' -%}{%- assign here = 'EG' -%}{%- endif -%}
    {%- for s in steps -%}{%- assign sp = s | split: ':' -%}
    <li class="xg-gg__step{% if sp[0] == here %} is-here{% endif %}"{% if sp[0] == here %} aria-current="true"{% endif %}><b>{{ sp[0] }}</b><span>{{ sp[1] }}</span></li>
    {%- endfor -%}
  </ol>
  {%- endunless -%}
  <p class="xg-gg__name"><strong>{{ gp[0] }}</strong></p>
  <dl class="xg-gg__facts">
    {%- if gp[1] != '-' -%}<div><dt>Scale</dt><dd>{{ gp[1] }}</dd></div>{%- endif -%}
    <div><dt>Height</dt><dd>{{ gp[2] }}</dd></div>
    <div><dt>Build time</dt><dd>{{ gp[3] }}</dd></div>
    {%- assign lvl = gp[4] | plus: 0 -%}
    <div><dt>Skill</dt><dd><span class="xg-gg__pips" aria-label="{{ lvl }} out of 5">{% for i in (1..5) %}<i{% if i <= lvl %} class="on"{% endif %}></i>{% endfor %}</span> {{ gp[5] }}</dd></div>
  </dl>
  <p class="xg-gg__txt">{{ gp[6] }}</p>
  <div class="xg-gg__tools" data-xg-gtools hidden>
    <h4 class="xg-gg__th">Build it right</h4>
    <div class="xg-gg__row"></div>
    <p class="xg-gg__msg" role="status"></p>
  </div>
</section>
<style>
  .xg-gg { --g-ink: #171b1d; --g-text: #3d454b; --g-mute: #6b757c; --g-line: #e3e7ea; --g-bg: #fff; --g-soft: #f6f8f9; --g-acc: #1f5fbf;
    margin: 18px 0 0; padding: 14px 16px; border: 1px solid var(--g-line); border-radius: 12px; background: var(--g-bg); max-width: 720px; font-size: 14px; line-height: 1.45; color: var(--g-text); }
  html[data-xg-theme="dark"] .xg-gg { --g-ink: #eef1f3; --g-text: #d5dbdf; --g-mute: #93a0a8; --g-line: #2f373c; --g-bg: #171c1f; --g-soft: #1e2428; --g-acc: #6aa5ff; }
  .xg-gg .xg-gg__h { margin: 0 0 10px; font-size: 12.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--g-ink); }
  .xg-gg__ladder { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; margin: 0 0 10px; padding: 0; list-style: none; counter-reset: none; }
  .xg-gg__step { margin: 0; padding: 6px 4px; border-radius: 8px; background: var(--g-soft); text-align: center; line-height: 1.15; list-style: none; }
  .xg-gg__step b { display: block; font-size: 13px; color: var(--g-ink); }
  .xg-gg__step span { font-size: 10.5px; color: var(--g-mute); }
  .xg-gg__step.is-here { background: var(--g-acc); }
  .xg-gg__step.is-here b, .xg-gg__step.is-here span { color: #fff; }
  .xg-gg__name { margin: 0 0 6px; color: var(--g-ink); }
  .xg-gg__facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 0 0 8px; }
  .xg-gg__facts div { padding: 6px 8px; border: 1px solid var(--g-line); border-radius: 8px; }
  .xg-gg__facts dt { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--g-mute); }
  .xg-gg__facts dd { margin: 1px 0 0; font-weight: 700; color: var(--g-ink); }
  .xg-gg__pips { display: inline-flex; gap: 2px; vertical-align: 1px; }
  .xg-gg__pips i { width: 7px; height: 7px; border-radius: 50%; background: var(--g-line); }
  .xg-gg__pips i.on { background: var(--g-acc); }
  .xg-gg__txt { margin: 0; }
  .xg-gg__tools[hidden] { display: none; }
  .xg-gg .xg-gg__th { margin: 14px 0 6px; font-size: 12.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--g-ink); }
  .xg-gg__row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .xg-gg__t { display: flex; flex-direction: column; gap: 3px; padding: 8px; border: 1px solid var(--g-line); border-radius: 10px; background: var(--g-bg); min-width: 0; }
  .xg-gg__t a { color: inherit !important; text-decoration: none !important; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .xg-gg__t img, .xg-gg__t .xg-gg__ph { display: block; width: 100%; height: 96px; object-fit: contain; border-radius: 7px; background: #fff; }
  .xg-gg__k { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--g-acc); }
  .xg-gg__n { font-size: 12.5px; font-weight: 600; line-height: 1.25; color: var(--g-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .xg-gg__w { font-size: 11.5px; color: var(--g-mute); line-height: 1.3; }
  .xg-gg__b { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: auto; padding-top: 4px; }
  .xg-gg__b span { font-weight: 700; color: var(--g-ink); font-size: 13px; }
  .xg-gg .xg-gg__add { height: 28px; padding: 0 10px; border: 0; border-radius: 7px; background: var(--xg-red, #d62c28); color: #fff !important; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  .xg-gg .xg-gg__add[disabled] { opacity: .65; }
  .xg-gg__msg { margin: 6px 0 0; font-size: 12.5px; color: var(--g-mute); }
  .xg-gg__msg:empty { display: none; }
  .xg-gg__msg a { color: inherit; text-decoration: underline; }
  @media (max-width: 560px) {
    .xg-gg { padding: 12px; }
    .xg-gg__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xg-gg__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xg-gg__step span { font-size: 9.5px; }
  }
</style>
<script>
  (function () {
    var box = document.querySelector('[data-xg-gtools]');
    if (!box || !window.fetch) return;
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    // "MR BASIC NIPPER II" -> "Mr Basic Nipper II"; words with digits (GM301) and roman numerals stay capitals
    function nice(t) {
      return String(t).split(/(\s+)/).map(function (w) {
        if (/\d/.test(w) || /^(I|II|III|IV|V|VI)$/i.test(w)) return w.toUpperCase();
        return w.toLowerCase().replace(/(^|[\-(\/])\S/g, function (x) { return x.toUpperCase(); });
      }).join('');
    }
    var picks = [];
    fetch('https://exor-binder.nevski.workers.dev/kit.json?for=gunpla').then(function (r) { return r.ok ? r.json() : null; }).then(function (k) {
      var cats = (k && k.cats || []).filter(function (c) { return c.items && c.items.length && c.items[0].v; });
      if (!cats.length) return;
      picks = cats.map(function (c) { return c.items[0]; });
      box.querySelector('.xg-gg__row').innerHTML = cats.map(function (c, i) {
        var it = c.items[0];
        return '<div class="xg-gg__t"><a href="/products/' + encodeURIComponent(it.handle) + '">' +
          (it.img ? '<img src="' + esc(it.img.replace(/(\.[a-z]+)(\?|$)/i, '_240x$1$2')) + '" alt="" loading="lazy" width="120" height="120">' : '<span class="xg-gg__ph"></span>') +
          '<span class="xg-gg__k">' + esc(c.label) + '</span><span class="xg-gg__n">' + esc(nice(it.title)) + '</span><span class="xg-gg__w">' + esc(c.why) + '</span></a>' +
          '<div class="xg-gg__b"><span>$' + esc(it.price) + '</span><button type="button" class="xg-gg__add" data-i="' + i + '">Add</button></div></div>';
      }).join('');
      box.hidden = false;
    }).catch(function () {});
    box.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('.xg-gg__add');
      if (!b) return;
      var it = picks[+b.getAttribute('data-i')];
      if (!it) return;
      b.disabled = true;
      var msg = box.querySelector('.xg-gg__msg');
      fetch('/cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ items: [{ id: it.v, quantity: 1 }] }) })
        .then(function (r) { return r.ok; }, function () { return false; })
        .then(function (ok) {
          b.disabled = false;
          if (ok) b.textContent = 'Added';
          msg.innerHTML = ok ? 'Added to your cart. <a href="/cart">View cart</a>' : 'Could not add it - please try again.';
          if (ok) {
            document.dispatchEvent(new CustomEvent('cart:refresh'));
            try { var sync = (window.Shopify && window.Shopify.adjustCartDropDown) || window.adjustCartDropDown; if (typeof sync === 'function') sync(); } catch (x) {}
          }
        });
    });
  })();
</script>
{%- endif -%}
