              "label":"Menu item",
              "info":"Enter menu item to customize the menu dropdown."
           },
           {
              "type":"checkbox",
              "id":"blog_show_new",
              "label":"Show New Tag",
              "default":false
           },
           {
              "type":"checkbox",
              "id":"blog_show_sale",
              "label":"Show Sale Tag",
              "default":false
           },
           {
              "type":"checkbox",
              "id":"blog_show_hot",
              "label":"Show Hot Tag",
              "default":false
           },
           {
              "type":"checkbox",
              "id":"blog_show_collection",
              "label":"Enable Product",
              "default":false
           },
