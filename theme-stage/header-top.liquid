                    {% if section.settings.logo %}
                    <a href="/" itemprop="url" class="header__logo-image">
                      {% capture image_size %}{{ section.settings.logo_max_width }}x{% endcapture %}
                      {% capture logo_alt %}{{ section.settings.logo.alt | default: shop.name }}{% endcapture %}
                      <img loading="lazy" src="{{ section.settings.logo | img_url: 'large' }}" alt="{{ logo_alt | escape }}" itemprop="logo" style="max-width: {{ section.settings.logo_max_width }}px; max-height: {{ section.settings.logo_max_height }}px;">
                    </a>
                    {% else %}
                    <a class="site-header__logo-link" href="/" itemprop="url">{{ shop.name }}</a>
                    {% endif %}
                    {% if template.name == 'index' %}
                </h1>
                {% else %}
