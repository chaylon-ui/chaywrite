     {
        "type":"checkbox",
        "id":"show_social",
        "label":"Show Social Icons",
        "default":true
     },
     {
        "type":"checkbox",
        "id":"show_checkout",
        "label":"Show Checkout",
        "default":true
     },
     {
        "type":"checkbox",
        "id":"show_wishlist",
