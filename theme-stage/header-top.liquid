  "settings":[
     {
        "type":"image_picker",
        "id":"logo",
        "label":"Theme Logo Image",
        "info":"Size: 200px X 50px"
     },
     {
        "type":"text",
        "id":"logo_max_width",
        "label":"Max Logo Width",
