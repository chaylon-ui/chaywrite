              {% endif %}
            </div>

            <div class="header-user-selection col-md-2 hidden-lg-down">
              {%- if localization.available_languages.size > 1 -%}
              {%- form 'localization', id: 'xg-lang-desk', class: 'xg-lang__form' -%}
              <div class="xg-lang" role="group" aria-label="Language / Langue">{{ xg_lang_items }}</div>
              {%- endform -%}
              {%- endif -%}
              <div id="_desktop_cart" class="hidden-lg-down">
                <div class="cart-display">
                  <div class="cart-title clearfix collapsed" data-target=".cart-container" data-toggle="collapse" aria-label="Cart" aria-role="button" tabindex="0">
                    <div class="site-header__cart expand-more">
                      <span class="cart-logo hidden-lg-down">{% include 'icons' with 'shopping-cart' %}</span>
                      <span class="cart-logo hidden-lg-up">{% include 'icons' with 'cart' %}</span>
                      <span class="cart-qty"></span>
                      </span>
                    </div>
                  </div>
                  <div class="cart-container cart-dropdown-inner cart-dropdown collapse">
                    {% include 'cart-dropdown'%}
                  </div>
                </div>
              </div>
              {% if shop.customer_accounts_enabled %}
              <div id="_desktop_user_info" class="user_info full-width hidden-lg-down ">
                <a href="/account" class="userinfo-title" aria-label="Account page">
                  <span class="userinfo-toggle hidden-lg-down">{% include 'icons' with 'user-desktop' %}</span>
                  <span class="userinfo-toggle hidden-lg-up">{% include 'icons' with 'user-mobile' %}</span>
                </a>
              </div>
              {% endif %}
              <div id="_desktop_search" class="site-header__search">
                {% include 'search-form' %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
{% include 'header-menu' %}
    <div class="mobile-width site-header-mobile hidden-lg-up">
      <div class="page-width">
        <div class="row">
          <div class="mobile-width-left">
            <div id="menu-icon" class="menu-icon hidden-lg-up">
              {% include 'icons' with 'setup' %}
            </div>
          </div>
          <div class="mobile-width-right">
            {%- if localization.available_languages.size > 1 -%}
            {%- form 'localization', id: 'xg-lang-mob', class: 'xg-lang__form' -%}
            <div class="xg-lang" role="group" aria-label="Language / Langue">{{ xg_lang_items }}</div>
            {%- endform -%}
            {%- endif -%}
            <div id="_mobile_cart"></div>
            <div id="_mobile_user_info"></div>
            <div id="_mobile_link_menu"></div>
          </div>
          {%- comment -%}
            Search is a sibling of the two columns, not a child of the right
            one, so it can take a full-width line of its own beneath the
            icons. Inside .mobile-width-right it was stuck with whatever the
            icons left over: measured at 390px it came to 70px wide with
            padding 5px 50px 5px 10px, i.e. about 10px to type in. shop.js
            fills this by id, so moving it does not change how it is filled.
          {%- endcomment -%}
          <div id="_mobile_search"></div>
        </div>
      </div>
    </div>
  </header>             
</div>
<script>
  /* Language switcher (see the comment above the capture near the top of
     this file). The native submit does the work; this only (1) keeps the
     query string - Shopify's own hidden return_to carries the path alone, so
     a search or a sorted collection would lose ?q= / ?sort_by= on the
     switch - and (2) refuses a second click while the first is in flight. */
  (function () {
    if (window.__xgLang) return;
    window.__xgLang = 1;
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (!f || !f.classList || !f.classList.contains('xg-lang__form')) return;
      if (f.getAttribute('aria-busy') === 'true') { e.preventDefault(); return; }
      var r = f.querySelector('input[name="return_to"]');
      if (!r) {
        r = document.createElement('input');
        r.type = 'hidden';
        r.name = 'return_to';
        f.appendChild(r);
      }
      r.value = location.pathname + location.search;
      f.setAttribute('aria-busy', 'true');
    }, true);
  })();
</script>
{% schema %}
