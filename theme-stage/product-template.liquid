{% if product.type == 'Event Ticket' %}
{% include 'events', data: settings %}
<script defer src="{{ 'productTemplate.js' | asset_url }}"></script>
{% else %}
<div class="product-template__container" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="product" data-enable-history-state="true">

  {% comment %}
  Get first variant, or deep linked one
  {% endcomment %}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign product_image_zoom_size = '1024x1024' -%}
  {%- assign product_image_scale = '2' -%}
  {%- assign enable_zoom = section.settings.enable_zoom -%}
  {% comment %} Hover-zoom fights the floating/tilt card effect — off for singles only. {% endcomment %}
  {% if product.type contains 'Single' %}{%- assign enable_zoom = false -%}{% endif %}

  {% case section.settings.image_size %}
  {% when 'small' %}
  {%- assign product_image_width = 'medium-up--one-third' -%}
  {%- assign product_description_width = 'medium-up--two-thirds' -%}
  {%- assign product_thumbnail_width = 'medium-up--one-third' -%}
  {%- assign height = 345 -%}
  {% when 'medium' %}
  {%- assign product_image_width = 'medium-up--one-half' -%}
  {%- assign product_description_width = 'medium-up--one-half' -%}
  {%- assign product_thumbnail_width = 'medium-up--one-quarter' -%}
  {%- assign height = 530 -%}
  {% when 'large' %}
  {%- assign product_image_width = 'medium-up--two-thirds' -%}
  {%- assign product_description_width = 'medium-up--one-third' -%}
  {%- assign product_thumbnail_width = 'medium-up--one-fifth' -%}
  {%- assign height = 720 -%}
  {% when 'full' %}
  {%- assign product_image_width = '' -%}
  {%- assign product_description_width = '' -%}
  {%- assign product_thumbnail_width = 'medium-up--one-eighth' -%}
  {%- assign height = 1090 -%}
  {%- assign enable_zoom = false -%}
  {% endcase %}

  <div class="row product-single">

    <div class="col-sm-6 product-single__photos product-single-left">
      <h3 class="product-single__title text-center hidden-sm-up">{{ product.title }}</h3>

      <div class="single-left">
        {%- assign featured_image = product.selected_or_first_available_variant.featured_image | default:
        product.featured_image -%}
        {% for image in product.images %}
        {% capture img_id %}FeaturedImage-{{ section.id }}-{{ image.id }}{% endcapture %}
        {% capture img_class %}product-featured-img{% endcapture %}
        {% capture zoom_img_id %}FeaturedImageZoom-{{ section.id }}-{{ image.id }}{% endcapture %}
        {% capture img_wrapper_id %}{{ zoom_img_id }}-wrapper{% endcapture %}
        {%- assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

        <div class="product-single__photo-wrapper js">
          <div id="{{ zoom_img_id }}" class="product-single__photo{% if enable_zoom %} js-zoom-enabled{% endif %}{% if product.images.size > 1 %} product-single__photo--has-thumbnails{% endif %}{% unless featured_image == image %} hide{% endunless %}" data-image-id="{{ image.id }}" {% if enable_zoom %} data-zoom="{{ image | img_url: product_image_zoom_size, scale: product_image_scale }}" {% endif %}>
            <img loading="lazy" class="feature-row__image {{ img_class }} lazyload{% unless featured_image == image %} lazypreload{% endunless %}" src="{{ image | img_url: '1000x1000' }}" data-widths="[1000]" alt="{{ image.alt | escape }}">
          </div>
        </div>
        {% endfor %}

        <noscript>

          <img loading="lazy" src="{{ featured_image }}" alt="{{ featured_image.alt }}" id="FeaturedImage-{{ section.id }}" class="product-featured-img">
        </noscript>
        {% if product.images.size > 1 %}
        {% if product.images.size > 3 %}
        {%- assign enable_thumbnail_slides = true -%}
        {% endif %}

        <div class="thumbnails-wrapper{% if enable_thumbnail_slides == true %} thumbnails-slider--active{% endif %}">
          <div class="js-qv-mask mask">
            <ul id="product-thumbnails-carousel" class="owl-carousel owl-theme grid grid--uniform product-single__thumbnails product-single__thumbnails-{{ section.id }}">
              {% for image in product.images %}
              <li class="product-single__thumbnails-item js">
                <a href="{{ image.src | img_url: product_image_zoom_size, scale: product_image_scale }}" class="text-link product-single__thumbnail product-single__thumbnail--{{ section.id }}" data-thumbnail-id="{{ image.id }}" {% if enable_zoom %}data-zoom="{{ image.src | img_url: product_image_zoom_size, scale: product_image_scale }}" {% endif %}>
                  <img alt="{{ image.alt | escape }}" class="product-single__thumbnail-image" loading="lazy" src="{{ image.src | img_url: '250x250'}}"/>
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="col-sm-6 product-single-right">
      <div class="product-single__meta">

        <h1 class="product-single__title hidden-sm-down">{{ product.title }}</h1>

<div class="price-product">
  <div class="product-single__price product-single__price-{{ section.id }}{% unless current_variant.available %} product-price--sold-out{% endunless %}">
    {% assign title_lower = product.title | downcase %}
{% assign is_preorder = false %}
{% if title_lower contains 'pre order' or title_lower contains 'pre-order' or title_lower contains 'preorder' %}
  {% assign is_preorder = true %}
{% endif %}
    {% if current_variant.price == 99999900 and is_preorder == false %}
      <span class="product-price__price product-price__price-{{ section.id }}">
                <span id="ProductPrice-{{ section.id }}" style="text-decoration: none; color: red;">
                          Please Email <a href="mailto:customerservice@exorgames.com?subject={{ product.title | escape }}">customerservice@exorgames.com</a> For $$ Pricing
                                  </span>
                                        </span>
{% elsif current_variant.price == 0 and is_preorder %}
  <span class="product-price__price product-price__price-{{ section.id }}">
    <span id="ProductPrice-{{ section.id }}" style="text-decoration: none; color: red;">
      Coming Soon
    </span>
  </span>
    {% elsif current_variant.compare_at_price > current_variant.price %}
      <span class="product-price__price product-price__sale">
        <s class="product-price__price is-bold" id="ProductPrice-{{ section.id }}">
          {{ current_variant.price | money }}
        </s>
      </span>
      <span class="product-price__price product-price__price-{{ section.id }} product-price__sale product-price__sale--single">
        <s id="ComparePrice-{{ section.id }}" class="regular-price">
          {{ current_variant.compare_at_price | money }}
        </s>
      </span>
    {% else %}
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      <span class="product-price__price product-price__price-{{ section.id }}">
        <span id="ProductPrice-{{ section.id }}" style="text-decoration: none;">
          {{ current_variant.price | money }}
        </span>
        <s id="ComparePrice-{{ section.id }}" class="regular-price hide">
          {{ current_variant.compare_at_price | money }}
        </s>
      </span>
    {% endif %}
  </div>
</div>
{% if product.type contains 'Single' %}<div class="xg-ph" data-xg-ph data-product-id="{{ product.id }}" hidden></div>{% endif %}
{%- comment -%} Blind boxes are sold one at a time (owner, 2026-09-23: "people may think they are buying
    the whole blind box not an individual item from the blind box"); the photos PLAMOD supplies often
    show the whole line-up or the display box, so say it plainly beside the price. {%- endcomment -%}
{% if product.type == 'Blind Box' %}<div class="xg-bb" role="note"><strong>Sold individually:</strong> you get one blind box, and the figure inside is a surprise. Photos may show the whole series or its display box.</div>
<style>.xg-bb{margin:10px 0 4px;padding:9px 12px;border-radius:10px;background:rgba(214,44,40,.08);border:1px solid rgba(214,44,40,.28);font-size:13.5px;line-height:1.45;color:var(--xg-ink,#10171a)}.xg-bb strong{color:var(--xg-red,#d62c28)}html[data-xg-theme="dark"] .xg-bb{background:rgba(255,106,94,.1);border-color:rgba(255,106,94,.35);color:#e6ebee}html[data-xg-theme="dark"] .xg-bb strong{color:#ff6a5e}</style>{% endif %}
{%- comment -%} "Also at our other Exor locations" (assets/xg-product-sisters.js): the card's
    name without its set bracket and the worker's game key for /sisterstock.json. {%- endcomment -%}
{% if product.type contains 'Single' %}<div data-xg-sis data-name="{{ product.title | split: ' [' | first | escape }}" data-game="{% if product.type contains 'Pokemon' %}pokemon{% elsif product.type contains 'Yugioh' %}yugioh{% elsif product.type contains 'Lorcana' %}lorcana{% elsif product.type contains 'One Piece' %}onepiece{% elsif product.type contains 'Star Wars' %}starwars{% elsif product.type contains 'Riftbound' %}riftbound{% elsif product.type contains 'Flesh' %}fab{% elsif product.type contains 'Hockey' %}hockey{% elsif product.type contains 'Basketball' %}basketball{% else %}mtg{% endif %}" hidden></div>{% endif %}

        {% for block in section.blocks %}
        {% case block.type %}
        {% when '@app' %}
        <div style="{% if forloop.last %}margin-bottom:20px{% else %}margin-bottom:10px{% endif %} ">
          {% render block %}
        </div>
        {% endcase %}
        {% endfor %}

        {% if settings.enable_zipPay %}
          <!-- Zip WIDGET -->
          {%include 'zip-widget'%}
          <style>
            #zip-prod-widget>iframe {
              position: relative !important;
              right: 20px !important;
            }
          </style>
          <div style="cursor:pointer" id="zip-prod-widget" data-zm-asset="productwidget" data-zm-widget="popup" data-zm-popup-asset="termsdialog"></div>
          <!-- end Zip WIDGET -->
        {% endif %}

        {% if section.settings.show_vendor %}
          <p class="product-single__vendor">{{ 'products.product.vendor' | t }}: <span>{{ product.vendor
              }}</span></p>
        {% endif %}
        {% if section.settings.show_Producttype %}
          <p class="product-single__vendor">{{ 'products.product.Producttype' | t }} :
            <span>{{product.type}}</span>
          </p>
        {% endif %}

        <div class="wishlist-chart">
          {% include 'wishlist-product' %}

          {% if section.settings.show_Grading_Guide and product.type contains 'Single'%}
          <button id="myBtn" class="btn btn-primary btn-lg size-chart" data-toggle="modal" data-target="#myModal"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="ruler-horizontal" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" class="svg-inline--fa fa-ruler-horizontal fa-w-20 fa-2x">
              <path fill="currentColor" d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm-16 208H48V176h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v160z" class=""></path>
            </svg>{{ 'products.product.gradingguide' | t }}</button>
          {% endif %}
        </div>

        {%- assign productquantity = section.settings.current_quantity -%}
        {% if section.settings.show_stock_alert %}
          <div class="progress-content{% if current_variant.inventory_quantity > productquantity %} hide{% endif %}" data-quantity="{{ productquantity }}">
            <div class="quantity-value">
              {{ 'products.product.stock-quantitymessage1' | t }}
              <div id="variant-stock" class="variant_quantity">
                {{ current_variant.inventory_quantity }}
              </div>
              {{ 'products.product.stock-quantitymessage2' | t }}
            </div>
            <div id="progress-bar">
              <span></span>
            </div>
          </div>
        {% endif %}
        {% if product.type != 'Event Ticket' and product.selected_or_first_available_variant.available and
        product.selected_or_first_available_variant.inventory_quantity <= 0 and product.selected_or_first_available_variant.inventory_policy=='continue' %}
          <div id="sold-out">
            <p class="notify-msg first" style="margin-bottom: 0px">
              {{ 'products.product.backorder-message' | t: title: product.title }}
            </p>
          </div>
        {% endif %}

      {% include 'notify-me' %}

      {% assign current_variant = product.selected_or_first_available_variant %}
      <div class="product-selection-bottom">
        <div class="product-selection {% unless section.settings.show_variant_labels %}product-form--hide-variant-labels{% endunless %}">
          {% form 'product', product, class:'product-form cart-product-page product-form-product-template', novalidate:
          'novalidate', data-product-form: '', data-section: section.id %}
          {% unless product.options.size == 1 and product.variants[0].title == 'Default Title' %}
          {% for option in product.options_with_values %}
          <div class="selector-wrapper js product-form__item">
            <label {% if option.name=='default' %}class="label--hidden" {% endif %}>
              {% if option.name == 'Title' %}Condition{% else %}{{ option.name }}{% endif %}
            </label>
            <select class="single-option-selector single-option-selector-{{ section.id }} product-form__input" id="SingleOptionSelector-{{ forloop.index0 }}" data-index="option{{ forloop.index }}">
              {% for value in option.values %}
              <option class="variant-option" value="{{ value | escape }}" {% if option.selected_value==value %} selected="selected" {% endif %}>{{ value }}</option>
              {% endfor %}
            </select>
          </div>
          {% endfor %}
          <div class="product-swatch">
            {% for option in product.options_with_values %}
            <div class="custom-swatch">
              <label {% if option.name=='default' %}class="label--hidden" {% endif %}>
                {% if option.name == 'Title' %}Condition{% else %}{{ option.name }}{% endif %}
              </label>
              <div class="option-swatch" data-selector="SingleOptionSelector-{{ forloop.index0 }}">
                {% for value in option.values %}
                  {% if option.name == 'color' or option.name == 'Color'%}
                    <span class="custom-swatch color-swatch{% if option.selected_value == value %} active{% endif %}" style="background-color: {{ value }};" data-index="{{ forloop.index | minus:1}}"></span>
                  {% else %}
                    {% assign sw_found = false %}
                    {% assign sw_price = 0 %}
                    {% assign sw_avail = false %}
                    {% if product.options.size == 1 %}
                      {% for sw_v in product.variants %}
                        {% if sw_v.title == value %}
                          {% assign sw_found = true %}
                          {% assign sw_price = sw_v.price %}
                          {% assign sw_avail = sw_v.available %}
                          {% break %}
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                    <span class="custom-swatch{% if option.selected_value == value %} active{% endif %}{% if sw_found and sw_avail == false %} swatch-oos{% endif %}" data-index="{{ forloop.index | minus:1}}"><span class="swatch-name">{{ value }}</span>{% if sw_found and sw_avail and sw_price < 9999900 %}<span class="swatch-price">{{ sw_price | money }}</span>{% endif %}</span>
                  {% endif%}
                {% endfor %}
              </div>
            </div>
            {% endfor %}
          </div>
          {% endunless %}
          <div class="quantity-cart">
            {% if section.settings.show_quantity_selector %}
              <div class="product-form__item product-form__item--quantity selector-wrapper">
                <label>{{ 'products.product.quantity' | t }}</label>
                <div class="dec button qtyminus">-</div>
                <input name="quantity" value="1" class="quantity">
                <div class="inc button qtyplus">+</div>
              </div>
            {% endif %}
            <select name="id" id="ProductSelect-{{ section.id }}" data-section="{{ section.id }}" class="product-form__variants no-js">
              {% for variant in product.variants %}
                {% if variant.available %}
                  <option {% if variant==product.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}" data-stock="{{ variant.inventory_quantity }}">
                    {{ variant.title }}
                  </option>
                  {% else %}
                  <option value="{{ variant.id }}" data-stock="{{ variant.inventory_quantity }}">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
                {% endif %}
              {% endfor %}
            </select>
            <div class="product-info {% unless product.available %}product-soldout {% endunless %}{% if current_variant.compare_at_price > current_variant.price %}product-sale{% endif %}">
              <div class="item_info">
                <div class="product-form__item product-form__item--submit">
                  {% if current_variant.price != 0 %}
                  <button type="button" id="AddToCart-{{ section.id }}" class="product-addToCart addToCart enable btn" {% unless current_variant.available %}disabled="disabled" {% endunless %}>
                    <span id="AddToCartText-{{ section.id }}"></span>
                  </button>
                  {% endif %}
                </div>
                <div id="inventory" class="available-stock">
                  <span class="instock">
                    <i class="material-icons product-available">&#xE5CA;</i> {{ 'products.product.instock' | t }}
                  </span>
                  <span class="outstock">
                    <i class="material-icons product-unavailable">&#xE14B;</i> {{ 'products.product.sold_out' | t }}
                  </span>
                </div>
              </div>
            </div>
          </div>
          <input type="hidden" name="return_to" value="back" />
{% if section.settings.show_spb and current_variant.price != 0 %}
  <div id="dynamic-checkout-container" class="dynamic-checkout{% if current_variant.available == false %} hidden{% endif %}">
    {{ form | payment_button }}
  </div>
{% endif %}
          {% endform %}
          <!-- </form> -->
        </div>
      </div>

      {% if settings.enable_productpage %}
        {% include 'reassurance' %}
      {% endif %}

      {% if section.settings.trust-image != blank and section.settings.show_trust_image %}
      <div class="trusted-img">
        <img alt="{{ section.settings.trust-image.alt | escape }}" data-sizes="auto" data-src="{{ img_url }}" loading="lazy" src="{{ section.settings.trust-image | img_url: '387x42' }}"/>
      </div>
      {% endif %}
    </div>
  </div>
</div>
</div>

{% if product.options.size == 1 %}
<script>
  (() => {
    const productOption = `{{ product.options[0] }}`.toLowerCase();
    const swatchOptions = document.querySelectorAll('.option-swatch .custom-swatch');
    const variantsToRemove = [
      {%  for variant in product.variants %}
        {% unless variant.available %}
          `{{ variant.title }}`.toLowerCase(),
        {% endunless %}
      {% endfor %}
    ];

    swatchOptions.forEach((opt, index) => {
      const optNameEl = opt.querySelector('.swatch-name');
      const optName = (optNameEl ? optNameEl.innerText : opt.innerText).trim().toLowerCase();
      if (opt && variantsToRemove.includes(optName)) {
        swatchOptions[index].classList.add('disabled-option');
        if (productOption !== 'color' || productOption !== 'colour') {
          swatchOptions[index].classList.add('non-color-option');
        }
      }
    })
  }) ();
</script>
{% endif %}

{% if product.type contains 'Single' %}
<script>
  (function () {
    var section = document.getElementById('ProductSection-{{ section.id }}');
    if (!section) return;
    var left = section.querySelector('.product-single-left');
    var master = document.getElementById('ProductSelect-{{ section.id }}');
    if (!left || !master) return;
    var prices = {
      {% for variant in product.variants %}"{{ variant.id }}": {{ variant.price }}{% unless forloop.last %},{% endunless %}{% endfor %}
    };
    left.classList.add('card-float');
    left.classList.add('xg-zoomable');
    {% if product.type contains 'Pokemon' %}left.classList.add('poke-holo');{% endif %}
    function selectedTitle() {
      var t = '';
      var opts = section.querySelectorAll('.single-option-selector');
      for (var i = 0; i < opts.length; i++) t += ' ' + (opts[i].value || '');
      var mo = master.options[master.selectedIndex];
      if (mo) t += ' ' + mo.text;
      return t.toLowerCase();
    }
    function refresh() {
      var pt = {% if product.type contains 'Pokemon' %}{{ product.title | downcase | json }}{% else %}''{% endif %};
      var foily = selectedTitle().indexOf('foil') !== -1 || (pt.indexOf('holo') !== -1 && pt.indexOf('holon') === -1);
      left.classList.toggle('foil-active', foily);
      var sz = document.querySelector('.sezzle-shopify-info-button');
      if (sz) sz.style.display = (prices[master.value] || 0) < 1000 ? 'none' : '';
    }
    document.addEventListener('change', function (e) {
      if (e.target && (e.target.name === 'id' || String(e.target.className).indexOf('single-option-selector') !== -1)) {
        setTimeout(refresh, 60);
      }
    }, true);
    // Theme switches variants via jQuery .trigger('change'), which does not
    // emit a native event — listen through jQuery too, and watch the price
    // node as a catch-all.
    if (window.jQuery) {
      window.jQuery(document).on('change', '.single-option-selector, select[name="id"]', function () {
        setTimeout(refresh, 60);
      });
    }
    var priceEl = document.querySelector('[id^="ProductPrice-"]');
    if (priceEl && window.MutationObserver) {
      new MutationObserver(function () { refresh(); }).observe(priceEl, { childList: true, subtree: true, characterData: true });
    }
    var szTries = 0;
    var szTimer = setInterval(function () {
      szTries++;
      if (document.querySelector('.sezzle-shopify-info-button') || szTries > 20) {
        refresh();
        clearInterval(szTimer);
      }
    }, 400);
    refresh();
    function openZoom() {
      var img = left.querySelector('.product-single__photo:not(.hide) img') || left.querySelector('.product-single__photo img');
      if (!img || !(img.currentSrc || img.src)) return;
      var ov = document.createElement('div');
      ov.className = 'xg-zoom-overlay';
      var big = document.createElement('img');
      big.src = img.currentSrc || img.src;
      big.alt = img.alt || '';
      ov.appendChild(big);
      function onKey(e) { if (e.key === 'Escape') close(); }
      function close() {
        if (ov.parentNode) ov.parentNode.removeChild(ov);
        document.removeEventListener('keydown', onKey);
        document.body.style.overflow = '';
      }
      ov.addEventListener('click', close);
      document.addEventListener('keydown', onKey);
      document.body.style.overflow = 'hidden';
      document.body.appendChild(ov);
    }
    left.addEventListener('click', function (e) {
      var p = e.target && e.target.closest ? e.target.closest('.product-single__photo') : null;
      if (!p || !left.contains(p)) return;
      e.preventDefault();
      openZoom();
    });
    var xgPhotos = left.querySelectorAll('.product-single__photo');
    for (var xi = 0; xi < xgPhotos.length; xi++) {
      xgPhotos[xi].setAttribute('tabindex', '0');
      xgPhotos[xi].setAttribute('role', 'button');
      xgPhotos[xi].setAttribute('aria-label', 'Expand image');
    }
    left.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var p = e.target && e.target.closest ? e.target.closest('.product-single__photo') : null;
      if (!p || !left.contains(p)) return;
      e.preventDefault();
      openZoom();
    });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      left.classList.remove('card-float');
      return;
    }
    if (!window.matchMedia('(pointer: fine)').matches) return;
    var maxDeg = 10;
    left.addEventListener('pointermove', function (e) {
      var photo = left.querySelector('.product-single__photo:not(.hide)');
      if (!photo) return;
      var r = photo.getBoundingClientRect();
      if (!r.width || !r.height) return;
      var px = (e.clientX - r.left) / r.width;
      var py = (e.clientY - r.top) / r.height;
      if (px < -0.15 || px > 1.15 || py < -0.15 || py > 1.15) return;
      px = Math.max(0, Math.min(1, px));
      py = Math.max(0, Math.min(1, py));
      left.classList.add('card-tilting');
      photo.style.setProperty('--ry', ((px - 0.5) * 2 * maxDeg).toFixed(2) + 'deg');
      photo.style.setProperty('--rx', ((0.5 - py) * 2 * maxDeg).toFixed(2) + 'deg');
      photo.style.setProperty('--mx', (px * 100).toFixed(1) + '%');
      photo.style.setProperty('--my', (py * 100).toFixed(1) + '%');
    });
    left.addEventListener('pointerleave', function () {
      left.classList.remove('card-tilting');
      var photos = left.querySelectorAll('.product-single__photo');
      for (var i = 0; i < photos.length; i++) {
        photos[i].style.setProperty('--ry', '0deg');
        photos[i].style.setProperty('--rx', '0deg');
        photos[i].style.setProperty('--mx', '50%');
        photos[i].style.setProperty('--my', '50%');
      }
    });
  })();
</script>
{% endif %}

{% if collection %}
  <div class="text-center return-link-wrapper page-width">
    <a href="{{ collection.url }}" class="btn btn--secondary btn--has-icon-before return-link">
      {% include 'icon-arrow-left' %}
      {{ 'products.product.back_to_collection' | t: title: collection.title }}
    </a>
  </div>
{% endif %}

{% unless product == empty %}
  <script type="application/json" id="ProductJson-{{ section.id }}">
    {{ product | json }}
  </script>
{% endunless %}

<script>
  window.getProductCtaBtnText = (
    variant = {{ product.selected_or_first_available_variant | json }},
    product = {{ product | json }},
    collection = {{ collection | json }},
    productCollectionsTitles = {{ product.collections | map: 'title' | json}},
    addToCart = "{{ 'products.product.add_to_cart' | t }}",
    backOrder = "{{ 'products.product.back_order' | t }}",
    soldOut = "{{ 'products.product.sold_out' | t }}",
    preOrder = "PREORDER"
  ) => {
    const variantsInventoryPolicy = {
      {% for variant in product.variants %}
      "{{variant.id}}" : "{{ variant.inventory_policy}}",
      {% endfor %}
    };

    const variantsInventoryQty = {
      {% for variant in product.variants %}
      "{{variant.id}}" : "{{ variant.inventory_quantity}}",
      {% endfor %}
    };

    const variantQty = variantsInventoryQty[variant.id];

    const variantInventoryPolicy = variantsInventoryPolicy[variant.id];

    let ctaBtnText;
    if (variant.available === false) {
      ctaBtnText = soldOut;
    } else if (
      collection?.title.includes('pre-order') ||
      collection?.title.includes('preorder') ||
      productCollectionsTitles.some(title => title.includes('pre-order')) ||
      productCollectionsTitles.some(title => title.includes('preorder')) ||
      product.tags.includes('preorder')
    ) {
      ctaBtnText = preOrder;
    } else if (product.type !== 'Event Ticket' && variantQty <= 0 && variantInventoryPolicy === 'continue') {
      ctaBtnText = backOrder;
    } else {
      ctaBtnText = addToCart;
    }
    return ctaBtnText;
  }

  const ctaBtn = document.querySelector("#AddToCartText-{{ section.id }}");
  if (ctaBtn) {
    ctaBtn.innerText = window.getProductCtaBtnText();
  }
</script>

<script>
  // click event for each swatch
  $(document).on(
    'click',
    '.product-swatch .custom-swatch .custom-swatch',
    function () {
      $(this).parent().find('.custom-swatch').removeClass('active');
      $(this).addClass('active');
      var selectorID = $(this).parent().data('selector');
      var index = $(this).data('index');
      $('#' + selectorID + ' option')
        .eq(index)
        .prop('selected', true)
        .trigger('change');
    }
  );
</script>

{% if settings.enable_manage_comics_2 %}
  {% include 'conditional-snippet', value: 'manage-comics-2-product' %}
{% endif %}

{% endif %}
