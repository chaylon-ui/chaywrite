  .xg-bc__army-chip small { font-size: 11px; font-weight: 600; opacity: .6; }
  .xg-bc__army-ico { flex: 0 0 auto; display: inline-block; width: 18px; height: 18px; background: currentColor; -webkit-mask: var(--xg-ico) center / contain no-repeat; mask: var(--xg-ico) center / contain no-repeat; }
  .xg-bc--logo .xg-bc__logo .xg-bc__army:has(.xg-bc__army-ico) { display: flex; align-items: center; justify-content: center; gap: 12px; }
