  .xg-bc__brand img { display: block; max-height: 34px; max-width: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 3px 8px rgba(0,0,0,.5)); }
  .xg-bc__brand:hover, .xg-bc__brand:focus-visible, .xg-bc__brand[aria-current="true"] { opacity: 1; border-color: rgba(255,255,255,.7); background: rgba(255,255,255,.08); }
  .xg-bc--logo .xg-bc__logo .xg-bc__army { display: block; margin: 4px 0 0; text-align: center; color: #fff; font: 800 clamp(20px, 2.6vw, 30px)/1.15 var(--xg-font-heading, var(--xg-font-body, sans-serif)); letter-spacing: .06em; text-transform: uppercase; text-shadow: 0 3px 12px rgba(0,0,0,.6); }
  .xg-bc__armies { margin: 14px auto 0; text-align: center; }
  .xg-bc__armies-h { display: block; margin: 0 0 8px; color: rgba(255,255,255,.7); font: 700 11px/1 var(--xg-font-body, sans-serif); letter-spacing: .16em; text-transform: uppercase; }
  .xg-bc__armies-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
