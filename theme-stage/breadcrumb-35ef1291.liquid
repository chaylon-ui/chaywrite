{%- if xg_bc_logo != '' -%}
<script>
  /* The search app's collection pages (/a/search/<handle>) rewrite the banner
     title with the collection's name after load, which drops the logo. Put
     it back whenever the title loses its image. */
  (function () {
    var box = document.currentScript && document.currentScript.previousElementSibling;
    if (!box || !box.classList.contains('xg-bc--logo')) return;
    var src = {{ xg_bc_logo | file_url | json }};
    function fix() {
      var h = box.querySelector('.head-title') || box.querySelector('h1');
      if (!h || h.querySelector('img')) return;
      var alt = (h.textContent || '').trim();
      var img = document.createElement('img');
      img.src = src; img.alt = alt; img.width = 460; img.height = 110;
      h.classList.add('xg-bc__logo');
      h.textContent = '';
      h.appendChild(img);
      {%- if xg_army_cur != '' %}
      img.alt = {{ xg_army_gname | json }};
      var sp = document.createElement('span');
      sp.className = 'xg-bc__army'; sp.textContent = {{ xg_army_name | json }};
      h.appendChild(sp);
      {%- endif %}
    }
    fix();
    if (window.MutationObserver) new MutationObserver(fix).observe(box, { childList: true, subtree: true, characterData: true });
    /* phones: the army chips scroll sideways - bring the current army into view */
    var cur = box.querySelector('.xg-bc__army-chip[aria-current]');
    if (cur && cur.parentNode.scrollWidth > cur.parentNode.clientWidth) cur.parentNode.scrollLeft = cur.offsetLeft - 16;
  })();
</script>
{%- endif -%}

{% endunless %}