<div class="breadcrumb-container{% if xg_bc_logo != '' or xg_bc_paints %} xg-bc--logo{% endif %}" style="{% if xg_bc_logo != '' or xg_bc_paints %}{% elsif settings.breadcrumb != blank %}background-image: url('{{ settings.breadcrumb | img_url: 'master' }}');{% else %}background-color: {{ settings.breadcrumb_background }};{% endif %}">
