<div class="page-width" data-section-id="{{ section.id }}" data-section-type="cart-template">
<style>
  .cart__clear-all { display: inline-block; vertical-align: middle; margin: 0 18px 0 0; font-size: 13px; color: #8a9299; text-decoration: none; white-space: nowrap; }
  .cart__clear-all:hover { color: #d62c28; text-decoration: underline; }
  .cart__clear-all .fa { margin-right: 5px; }
  /* Delivery-vs-pickup nudge above the checkout button; shoppers keep
     missing that DoorDash local delivery exists as a checkout option. */
  .xg-delivery-note {
    margin: 10px 0 12px;
    padding: 10px 12px;
    border: 1px solid rgba(214, 44, 40, 0.25);
    border-left: 4px solid var(--xg-red, #d62c28);
    border-radius: 10px;
    background: var(--xg-red-soft, rgba(214, 44, 40, 0.06));
    font-size: 13px;
    line-height: 1.45;
    color: #333b40;
    text-align: left;
  }
  .xg-delivery-note strong { color: var(--xg-red, #d62c28); }
  /* Trust box above Checkout (2026-10-01) */
  .xg-trust { margin: 10px 0 12px; padding: 4px 12px; border: 1px solid var(--xg-border, #e3e6e8); border-radius: 10px; background: var(--xg-surface, #fff); font-size: 13px; line-height: 1.45; color: var(--xg-text, #333b40); text-align: left; }
  .xg-trust__row { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; border-bottom: 1px solid var(--xg-border, #eef0f2); }
  .xg-trust__row:last-child { border-bottom: 0; }
  .xg-trust__ic { flex: none; display: inline-flex; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 7px; background: var(--xg-red-soft, rgba(214, 44, 40, 0.08)); color: var(--xg-red, #d62c28); margin-top: 1px; }
  .xg-trust__ic svg { width: 15px; height: 15px; }
  .xg-trust strong { color: var(--xg-ink, #171b1d); }
  .xg-trust a { color: var(--xg-red, #d62c28); text-decoration: underline; text-underline-offset: 2px; }
  .xg-trust__hours { color: var(--xg-muted, #6b7378); }
  .xg-trust__hours:not(:empty)::before { content: ""; }
</style>
  {% if cart.item_count > 0 %}
  <div class="section-header text-center">
    <h1>{{ 'cart.general.title' | t }}</h1>
  </div>

  <form action="/cart" method="post" novalidate class="cart spurit-checkout">
    <table>
      <thead class="cart__row cart__header">
        <th class="product-info" colspan="2">{{ 'cart.label.product' | t }}</th>
        <th class="product-price">{{ 'cart.label.price' | t }}</th>
        <th class="product-quantity">{{ 'cart.label.quantity' | t }}</th>
        <th class="total-product">{{ 'cart.label.total' | t }}</th>
        <th class="product-remove">{{ 'cart.label.remove' | t }}</th>
      </thead>
      <tbody>
        {% for item in cart.items %}
        <tr class="cart__row border-bottom line{{ forloop.index }} cart-flex{% if forloop.first %} border-top{% endif %}">
          <td class="cart__image-wrapper cart-flex-item">
            <a href="{{ item.url | within: collections.all }}">
              <img loading="lazy" class="cart__image" src="{{ item | img_url: '95x95', scale: 2 }}" alt="{{ item.title | escape }}">
            </a>
          </td>
          <td class="cart__meta  cart-flex-item">
            <div class="list-view-item__title">
              <a href="{{ item.url }}">
                {{ item.product.title }}
                {% if item.quantity > 1 %}
                <span class="medium-up--hide"><span class="visually-hidden">{{ 'cart.label.quantity' | t }}</span>(x{{
                  item.quantity }})</span>
                {% endif %}
              </a>
            </div>
            {% unless item.variant.title contains 'Default' %}
            <div class="cart__meta-text">
              {% for option in item.product.options %}
              {{ option }}: {{ item.variant.options[forloop.index0] }}<br />
              {% endfor %}
            </div>
            {% endunless %}
            {% if item.product.type != 'Event Ticket' and item.product.selected_or_first_available_variant.available and
            item.product.selected_or_first_available_variant.inventory_quantity <= 0 and product.selected_or_first_available_variant.inventory_policy=='continue' %} <div class="cart__meta-text" style="color: red; font-size: 10px;">
              {{ 'cart.general.item-backorder' | t }}
</div>
{% endif %}

{% comment %}
Optional, loop through custom product line items if available

Line item properties come in as having two parts. The first part will be passed with the default form,
but p.last is the actual custom property and may be blank. If it is, don't show it.

For more info on line item properties, visit:
-
http://docs.shopify.com/support/your-store/products/how-do-I-collect-additional-information-on-the-product-page-Like-for-a-monogram-engraving-or-customization
{% endcomment %}
{%- assign property_size = item.properties | size -%}
{% if property_size > 0 %}
<div class="cart__meta-text">
  {% for p in item.properties %}
  {%- comment -%} A property named with a leading underscore is a marker
      for us (the Deck Builder's _deck), never a note for the shopper -
      checkout hides those already. {%- endcomment -%}
  {%- assign p_lead = p.first | slice: 0 -%}
  {% unless p.last == blank or p_lead == '_' %}
  {{ p.first }}:

  {% comment %}
  Check if there was an uploaded file associated
  {% endcomment %}
  {% if p.last contains '/uploads/' %}
  <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
  {% else %}
  {{ p.last }}
  {% endif %}
  {% endunless %}
  {% endfor %}
</div>
{% endif %}

</td>
<td class="cart__price-wrapper cart-flex-item product-price">

  {{ item.price | money }}

  {% for discount in item.discounts %}
  <div class="cart-item__discount">{{ discount.title }}</div>
  {% endfor %}

  <div class="cart__edit medium-up--hide">
    <button aria-label="Change Quantity" title="Change Quantity" type="button" class="btn btn--secondary btn--small js-edit-toggle cart__edit--active" data-target="line{{ forloop.index }}">
      <span class="cart__edit-text--edit"><i class="fa fa-pencil" aria-hidden="true"></i></span>
      <span class="cart__edit-text--cancel"><i class="fa fa-times" aria-hidden="true"></i></span>
    </button>
  </div>
</td>
<td class="cart__update-wrapper cart-flex-item product-quantity">
  <div class="cart__qty cart-qty-btns">
    <label for="updates_{{ item.key }}" class="cart__qty-label">{{ 'cart.label.quantity' | t }}</label>
    <div class="dec button qtyminus">-</div>
    <input class="cart__qty-input quantity update-cart" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0">
    <div class="inc button qtyplus">+</div>
  </div>
</td>
<td class=" small--hide total-product">
  {% if item.original_line_price != item.line_price %}
  <div class="cart-item__original-price"><s>{{ item.original_line_price | money }}</s></div>
  {% endif %}

  <div>
    {{ item.line_price | money }}
  </div>

  {% for discount in item.discounts %}
  <div class="cart-item__discount">{{ discount.title }}</div>
  {% endfor %}
</td>
<td class="product_remove">
  <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" class="cart__remove" aria-label="Remove this item">
    {{ 'cart.general.remove' | t }}<i class="fa fa-trash-o" aria-hidden="true"></i>
  </a>
</td>
</tr>
{% endfor %}
{% if section.settings.cart_notes_enable %}
<tr class="cart_top cart__row line3 cart-flex">
  <td colspan="6" style="padding-bottom: 0 !important; width: 100%;">
    <div class="cart-note">
      <label for="CartSpecialInstructions" class="cart-note__label">{{ 'cart.general.note' | t }}</label>
      <textarea name="note" id="CartSpecialInstructions" class="cart-note__input">{{ cart.note }}</textarea>
    </div>
    <div class="update_cart">
      <a href="/cart/clear" class="cart__clear-all" onclick="return confirm('Remove all items from your cart?');"><i class="fa fa-trash-o" aria-hidden="true"></i> Remove all items</a>
      <input type="submit" name="update" class="btn btn--secondary update-qty cart__update cart__update--large" value="{{ 'cart.general.update' | t }}">
      <hr />
      {% render 'xg-store-credit', enabled: section.settings.store_credit_enable %}
    </div>
  </td>
</tr>
{% else %}
<tr class="update_cart cart__row line3 cart-flex" style="text-align: right; margin-top: 15px;">
  <td colspan="6" style="padding-bottom: 0 !important; width: 100%;">
    <div style="text-align: right;">
      <a href="/cart/clear" class="cart__clear-all" onclick="return confirm('Remove all items from your cart?');"><i class="fa fa-trash-o" aria-hidden="true"></i> Remove all items</a>
      <input type="submit" name="update" class="btn btn--secondary update-qty cart__update cart__update--large" value="{{ 'cart.general.update' | t }}">
    </div>
    <hr />
    {% render 'xg-store-credit', enabled: section.settings.store_credit_enable %}
  </td>
</tr>
{% endif %}
</tbody>
</table>
<footer class="cart__footer">
  <div class="grid">
    {% for block in section.blocks %}
    {% case block.type %}
    {% when '@app' %}
    <div>
      {% render block %}
    </div>
    {% endcase %}
    {%endfor %}
    <div class="cart-bottm {% if settings.enable_cartpage %}cart_calculator_reassurance{% endif %}">
      <div class="cart_calculator">
        <div class="cart_content_inner">
          {%- comment -%} Store credit line (assets/xg-credit-nudge.js, owner 2026-09-29) {%- endcomment -%}
          <div data-xg-cn-cart data-total="{{ cart.total_price }}" hidden></div>
          <div class="cart_total_title">
            <span class="cart__subtotal-title">{{ 'cart.general.subtotal' | t }}</span>
            <span class="cart__subtotal">{{ cart.total_price | money }}</span>
          </div>
          {% if cart.total_discounts > money %}
          <div class="cart__savings">
            {{ 'cart.general.savings' | t }}
            <span class="cart__savings-amount">{{ cart.total_discounts | money }}</span>
          </div>
          {% endif %}
          <div class="cart__shipping">{{ 'cart.general.shipping_at_checkout' | t }}</div>
          {%- comment -%}
            Trust box above the checkout button (owner 2026-10-01,
            recommendation 10): the pickup promise with live store hours,
            local delivery, how singles ship, and the returns policy, all in
            one place where people hesitate. Hours come from the worker's
            /stores.json (Google Business hours, cached), the same feed the
            Locations strip uses; without it the pickup line still reads.
          {%- endcomment -%}
          <div class="xg-trust" data-xg-trust>
            <div class="xg-trust__row">
              <span class="xg-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9 4.5 4h15L21 9"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/></svg></span>
              <span><strong>Free in-store pickup.</strong> Choose it at checkout and we have your order ready at the counter. <span class="xg-trust__hours" data-xg-trust-hours></span></span>
            </div>
            <div class="xg-trust__row">
              <span class="xg-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg></span>
              <span><strong>Live nearby? We deliver.</strong> Pick <b>local delivery via DoorDash</b> at checkout.</span>
            </div>
            <div class="xg-trust__row">
              <span class="xg-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8l9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/></svg></span>
              <span><strong>Singles ship protected.</strong> Tracked, in a padded mailer. Add anything else and choose Expedited so it packs safely.</span>
            </div>
            <div class="xg-trust__row">
              <span class="xg-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg></span>
              <span><strong>Not right? We make it right.</strong> <a href="/policies/refund-policy">Returns policy</a> &middot; <a href="/policies/shipping-policy">Shipping policy</a> &middot; <a href="mailto:customerservice@exorgames.com">Email us</a></span>
            </div>
          </div>
          <script>
          /* Today's hours for the pickup line, store by store, from the same
             feed as the Locations strip. Store clock, never the shopper's. */
          (function () {
            var slot = document.querySelector('[data-xg-trust-hours]');
            if (!slot || window.__xgTrustHours) return;
            window.__xgTrustHours = 1;
            function mins(t) { return parseInt(t.slice(0, 2), 10) * 60 + parseInt(t.slice(2, 4), 10); }
            function fmt(t) { var h = parseInt(t.slice(0, 2), 10), m = parseInt(t.slice(2, 4), 10); var h12 = h % 12 || 12; return h12 + (m ? ':' + (m < 10 ? '0' + m : m) : '') + ' ' + (h >= 12 ? 'pm' : 'am'); }
            function today(store) {
              var hours = store && store.hours; if (!hours || !Array.isArray(hours.periods)) return null;
              var off = typeof store.utcOffsetMin === 'number' ? store.utcOffsetMin : 0;
              var d = new Date(Date.now() + off * 60000), day = d.getUTCDay(), cur = d.getUTCHours() * 60 + d.getUTCMinutes();
              for (var i = 0; i < hours.periods.length; i++) {
                var p = hours.periods[i]; if (!p || !p.open || p.open.day !== day || !/^\d{4}$/.test(String(p.open.time))) continue;
                if (!p.close) return 'open 24 hours';
                if (!/^\d{4}$/.test(String(p.close.time))) continue;
                var o = mins(p.open.time), c = p.close.day === day ? mins(p.close.time) : 1440 + mins(p.close.time);
                if (cur < o) return 'opens ' + fmt(p.open.time) + ' today';
                if (cur < c) return 'open until ' + fmt(p.close.time) + ' today';
                return 'closed for today';
              }
              return 'closed today';
            }
            var ctl = ('AbortController' in window) ? new AbortController() : null;
            var tmo = ctl ? setTimeout(function () { try { ctl.abort(); } catch (e) {} }, 7000) : null;
            fetch('https://exor-binder.nevski.workers.dev/stores.json', { signal: ctl ? ctl.signal : undefined })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (d) {
                if (tmo) clearTimeout(tmo);
                if (!d || d.ok !== true || !Array.isArray(d.stores)) return;
                var parts = [];
                for (var i = 0; i < d.stores.length && parts.length < 3; i++) {
                  var s = d.stores[i], t = today(s), nm = s && (s.city || s.name);
                  if (nm && t) parts.push(String(nm).replace(/^Exor Games\s*/i, '') + ' ' + t);
                }
                if (parts.length) slot.textContent = parts.join(' · ') + '.';
              }).catch(function () {});
          })();
          </script>
          <input type="submit" name="checkout" class="btn btn--small-wide checkout_btn spurit-checkout" value="{{ 'cart.general.checkout' | t }}">
          {% if additional_checkout_buttons %}
          <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
          {% endif %}
        </div>
      </div>
      <div class="cart_reassurance">
        {% if settings.enable_cartpage %}
          {% include 'reassurance' %}
        {% endif %}
        <div class="continue_shopping">
          <a href="/collections" class="btn btn--secondary cart__continue cart__continue--large">{{
            'cart.general.continue_shopping' | t }}</a>
        </div>
      </div>
    </div>

  </div>
</footer>
</form>
{% else %}
<div class="empty-page-content text-center">
  <h1>{{ 'cart.general.title' | t }}</h1>
  <p class="cart--empty-message">{{ 'cart.general.empty' | t }}</p>
  <div class="cookie-message">
    <p>{{ 'cart.general.cookies_required' | t }}</p>
  </div>
  <a href="/" class="btn btn--has-icon-after cart__continue-btn">{{ 'general.404.link' | t }}{% include
    'icon-arrow-right' %}</a>
</div>
{% endif %}
</div>

{% schema %}

{
"name": "Cart Page",
"settings": [
{
"type": "checkbox",
"id": "cart_notes_enable",
"label": "Enable Cart Notes",
"default": false
},
{
"type": "checkbox",
"id": "store_credit_enable",
"label": "Enable BinderPOS Store Credit",
"default": true
}
],
"blocks":[
{
"type":"@app"
}
],
"presets":[
{
"name":"Cart Items"
}
],
"templates":["cart"]
}

{% endschema %}