      dot(g, 'xg-pp__dot', first) + esc(g.n) + '<span class="xg-pp__code">' + (esc(first.c) || (state.brand === 'All' ? '' : '&nbsp;')) + (its.length > 1 ? ' +' + (its.length - 1) : '') + '</span>' +
