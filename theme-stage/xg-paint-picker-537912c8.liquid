  .xg-pp__sheet[hidden] { display: none; }
  .xg-pp__backdrop { position: absolute; inset: 0; background: rgba(8,10,12,.62); }
  .xg-pp__card { position: relative; background: var(--xg-surface); color: var(--xg-text); border-radius: 16px; max-width: 660px; width: 100%; max-height: 94vh; overflow-y: auto; display: grid; grid-template-columns: 1fr 1.1fr; box-shadow: 0 20px 60px rgba(0,0,0,.45); }
  .xg-pp__photo { background: #fff; display: flex; align-items: center; justify-content: center; padding: 18px; min-height: 280px; border-radius: 16px 0 0 0; }
  .xg-pp__photo img { max-width: 100%; max-height: 320px; object-fit: contain; }
  .xg-pp__info { padding: 22px 22px 20px; }
  .xg-pp__chip { width: 100%; height: 54px; border-radius: 10px; margin-bottom: 12px; box-shadow: inset 0 -10px 18px rgba(0,0,0,.2), 0 0 0 1px rgba(0,0,0,.1); }
  .xg-pp__range { margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--xg-muted); }
  .xg-pp__name { margin: 2px 0 8px; font-family: var(--xg-font-display); color: var(--xg-ink); font-size: 24px; text-transform: uppercase; }
  .xg-pp__opts { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
  .xg-pp__opts button { font: 600 12px/1.2 var(--xg-font-body); border: 1px solid var(--xg-border); background: var(--xg-surface); color: var(--xg-ink); border-radius: 8px; padding: 7px 10px; cursor: pointer; text-align: left; }
  .xg-pp__opts button span { display: block; font-weight: 500; color: var(--xg-muted); margin-top: 2px; }
  .xg-pp__opts button[aria-pressed="true"] { border-color: var(--xg-red); box-shadow: 0 0 0 1px var(--xg-red); }
