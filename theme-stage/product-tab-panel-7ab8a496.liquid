<div class="page-width product-tab">
  <ul class="tabs nav-tabs tab-id" role="tablist">
    {% if section.settings.show_description %}
    <li class="tab-item"><a class="nav-link" data-toggle="tab" role="tab" href="#desc"><span>{{
          'products.product.description' | t }}</span></a></li>
    {% endif %}
    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'policy' %}
    <li class="tab-item">
      <a class="nav-link" data-toggle="tab" role="tab" href="#{{block.settings.policy_page}}">
        <span>{{block.settings.policy_page | replace: "_", " " }}</span>
      </a>
    </li>
    {% endcase %}
    {% endfor %}
  </ul>
  <div class="tab-content" id="tab-content">
    {% if section.settings.show_description %}
    <div id="desc" class="tab-pane fade in active" role="tabpanel">
      {%- comment -%}
        Board games (owner 2026-09-13, "layed out like BGG"): when the product
        has no description of its own, the BoardGameGeek description filled by
        the nightly enrichment (exor.bgg_description) is shown instead, and a
        Classification card (type, categories, mechanisms) sits beside the text
        like BGG's own page. Other products render exactly as before.
      {%- endcomment -%}
      {%- liquid
        assign gf = product.metafields.exor
        assign use_bgg = false
        if product.description == blank and gf.bgg_description.value != blank
          assign use_bgg = true
        endif
        assign show_class = false
        if gf.categories.value != blank or gf.mechanics.value != blank
          assign show_class = true
        endif
        comment
          Gunpla (owner 2026-09-23, "auto update stats and specs like with
          board games"): the nightly enrichment (chaywrite src/gunpla.js)
          fills exor.gp_* from the title and Bandai's own kit page; a Kit
          specs card shows them, and a kit with no description of its own gets
          one plain sentence built from the same facts.
        endcomment
        assign show_kit = false
        if gf.gp_grade.value != blank
          assign show_kit = true
        endif
        comment
          Figures and blind boxes (owner 2026-09-23): brand, series and release
          date from PLAMOD, the distributor (exor.pl_*, chaywrite
          src/plamod.js - case / carton wording never gets that far). Blind
          boxes always get the card, for its "Sold as: one blind box" line.
        endcomment
        assign show_pl = false
        if product.type == 'Blind Box'
          assign show_pl = true
        elsif product.type == 'Figures' or product.type == 'Plastic Model Kit' or product.type == 'Plastic Model Kit Accessories' or product.type == 'Scale Models'
          comment
            Plastic model kits too (owner 2026-09-24: "the Pokemon models and
            other plastic models can probably fall under the plamod update").
          endcomment
          if gf.pl_brand.value != blank or gf.pl_series.value != blank or gf.pl_release.value != blank
            assign show_pl = true
          endif
        endif
        comment
          Warhammer 40,000 unit boxes (owner 2026-09-24, "warhammer, lets do
          it"): the nightly enrichment (chaywrite src/w40k.js) stores the
          matching BSData datasheet in exor.wh_unit (json) - faction, model
          count, points per size, stat lines, keywords, weapon profiles.
          Unofficial community data, refreshed weekly; no rules text.
        endcomment
        assign wu = gf.wh_unit.value
        assign show_wh = false
        if wu.name != blank
          assign show_wh = true
        endif
        comment
          BattleTech ForcePacks and Salvage Boxes (owner 2026-09-25, "lets do battle
          tech"): the nightly enrichment (chaywrite src/bt.js) stores what is in
          the box in exor.bt_pack (json) - pack name and, per unit, tonnage,
          weight class, tech base, role, movement, year, Master Unit List id.
        endcomment
        assign btp = gf.bt_pack.value
        assign show_bt = false
        if btp.units.size > 0
          assign show_bt = true
        endif
        assign pl_when = ''
        assign plrel = gf.pl_release.value | append: ''
        if plrel.size == 10
          assign pl_when = plrel | date: '%B %-d, %Y'
        elsif plrel.size == 7
          assign pl_when = plrel | append: '-01' | date: '%B %Y'
        endif
        assign kit_when = ''
        assign rel = gf.gp_release.value | append: ''
        if rel.size == 10
          assign kit_when = rel | date: '%B %-d, %Y'
        elsif rel.size == 7
          assign kit_when = rel | append: '-01' | date: '%B %Y'
        elsif rel.size == 4
          assign kit_when = rel
        endif
      -%}
      {%- if use_bgg or show_class or show_kit or show_pl or show_wh or show_bt -%}
      <div class="xg-desc{% if show_class or show_kit or show_pl or show_wh or show_bt %} xg-desc--split{% endif %}{% if show_bt %} xg-desc--bt{% endif %}{% if show_wh %} xg-desc--wh{% if product.description == blank and use_bgg == false %} xg-desc--wh-bare{% endif %}{% endif %}" data-xg-handle="{{ product.handle | escape }}">
        <div class="xg-desc__body">
          {%- if use_bgg -%}
            <div class="xg-desc__text">{{ gf.bgg_description.value | escape | newline_to_br }}</div>
            <p class="xg-desc__note">Description from <a href="https://boardgamegeek.com/boardgame/{{ gf.bgg_id.value }}" target="_blank" rel="noopener">BoardGameGeek</a>.</p>
          {%- elsif show_kit and product.description == blank -%}
            <div class="xg-desc__text">
              {{- product.title | escape }} is {% if gf.gp_grade.value contains 'Entry' or gf.gp_grade.value contains 'SD' %}an{% else %}a{% endif %} {{ gf.gp_grade.value | escape }}
              {%- if gf.gp_grade_code.value != blank %} ({{ gf.gp_grade_code.value | escape }}){% endif %} Gunpla model kit
              {%- if gf.gp_scale.value != blank %} in {{ gf.gp_scale.value }} scale{% endif %}
              {%- if gf.gp_line.value != blank %} from the {{ gf.gp_line.value | escape }} line{% endif %}
              {%- if kit_when != blank %}, released by Bandai {% if rel.size == 10 %}on{% else %}in{% endif %} {{ kit_when }}{% endif %}.
            </div>
          {%- else -%}
            {{ product.description }}
          {%- endif -%}
        </div>
        {%- if show_kit -%}
        <aside class="xg-class" aria-label="Kit specs">
          <h3 class="xg-class__title">Kit specs</h3>
          <dl>
            <dt>Grade</dt><dd>{{ gf.gp_grade.value | escape }}{% if gf.gp_grade_code.value != blank %} ({{ gf.gp_grade_code.value | escape }}){% endif %}</dd>
            {%- if gf.gp_line.value != blank -%}<dt>Line</dt><dd>{{ gf.gp_line.value | escape }}</dd>{%- endif -%}
            {%- if gf.gp_scale.value != blank -%}<dt>Scale</dt><dd>{{ gf.gp_scale.value | escape }}</dd>{%- endif -%}
            {%- if gf.gp_number.value != blank -%}<dt>Kit number</dt><dd>#{{ gf.gp_number.value | escape }}</dd>{%- endif -%}
            {%- if gf.gp_series.value != blank -%}<dt>Series</dt><dd>{{ gf.gp_series.value | escape }}</dd>{%- endif -%}
            {%- if kit_when != blank -%}<dt>Released</dt><dd>{{ kit_when }}</dd>{%- endif -%}
            {%- if gf.gp_age.value != blank -%}<dt>Age</dt><dd>{{ gf.gp_age.value }}+</dd>{%- endif -%}
            {%- comment -%} No Japan list price here (owner, 2026-09-23: "remove the japan list price from our page"); gp_price_jpy stays in the data. {%- endcomment -%}
          </dl>
          {%- if gf.gp_bandai_url.value != blank -%}
          <p class="xg-class__hint"><a href="{{ gf.gp_bandai_url.value }}" target="_blank" rel="noopener">Official kit page on Bandai Hobby &#8599;</a></p>
          {%- endif -%}
        </aside>
        {%- endif -%}
        {%- if show_pl -%}
        <aside class="xg-class" aria-label="Product specs">
          <h3 class="xg-class__title">Product specs</h3>
          <dl>
            {%- if product.type == 'Blind Box' -%}<dt>Sold as</dt><dd>One blind box (contents are random)</dd>{%- endif -%}
            {%- if gf.pl_brand.value != blank -%}<dt>Brand</dt><dd>{{ gf.pl_brand.value | escape }}</dd>{%- endif -%}
            {%- if gf.pl_series.value != blank -%}<dt>Series</dt><dd>{{ gf.pl_series.value | escape }}</dd>{%- endif -%}
            {%- if pl_when != blank -%}<dt>Released</dt><dd>{{ pl_when }}</dd>{%- endif -%}
          </dl>
        </aside>
        {%- endif -%}
        {%- if show_wh -%}
        {%- comment -%}
          Army, datasheet, unit size, points and keywords are chips (owner
          2026-09-25: "make these clickable so you can bring up other warhammer
          comps? like how we do by boardgames"): each opens the other 40K boxes
          in stock that share it (worker /w40k/like.json). Size, points and
          keywords stay inside this army (data-army).
        {%- endcomment -%}
        {%- assign wh_army = wu.faction | escape -%}
        {%- assign wh_name = wu.name | remove: ' [Legends]' | escape -%}
        <aside class="xg-class xg-unit" aria-label="Unit specs" data-army="{{ wh_army }}">
          <h3 class="xg-class__title">Unit specs</h3>
          <dl>
            <dt>Army</dt><dd><button type="button" class="xg-chip xg-chip--v" data-wkind="army" data-value="{{ wh_army }}" title="Other {{ wh_army }} in stock">{{ wh_army }}</button>{% if wu.legends %} <span class="xg-unit__tag">Legends</span>{% endif %}</dd>
            <dt>Datasheet</dt><dd><button type="button" class="xg-chip xg-chip--v" data-wkind="datasheet" data-value="{{ wh_name }}" title="Other {{ wh_name }} boxes in stock">{{ wh_name }}</button></dd>
            {%- if wu.models -%}
            {%- if wu.models[0] == wu.models[1] -%}{%- assign wh_size = wu.models[0] | append: '' -%}{%- else -%}{%- assign wh_size = wu.models[0] | append: '-' | append: wu.models[1] -%}{%- endif -%}
            <dt>Unit size</dt><dd><button type="button" class="xg-chip xg-chip--v" data-wkind="size" data-value="{{ wh_size }}" title="Other {{ wh_army }} units of this size in stock">{% if wu.models[0] == wu.models[1] %}{{ wu.models[0] }} {% if wu.models[0] == 1 %}model{% else %}models{% endif %}{% else %}{{ wu.models[0] }}&ndash;{{ wu.models[1] }} models{% endif %}</button></dd>
            {%- endif -%}
            {%- if wu.sizes.size > 0 -%}
            <dt>Points</dt>
            <dd><ul class="xg-unit__pts">{% for z in wu.sizes %}<li><span>{{ z.m | replace: '-', '&ndash;' }} model{% unless z.m == '1' %}s{% endunless %}</span><button type="button" class="xg-chip xg-chip--v" data-wkind="points" data-value="{{ z.p }}" title="Other {{ wh_army }} units around {{ z.p }} pts in stock">{{ z.p }} pts</button></li>{% endfor %}</ul></dd>
            {%- endif -%}
          </dl>
          {%- for st in wu.stats -%}
          <table class="xg-unit__stats">
            {%- if wu.stats.size > 1 -%}<caption>{{ st.name | escape }}</caption>{%- endif -%}
            <thead><tr><th>M</th><th>T</th><th>SV</th><th>W</th><th>LD</th><th>OC</th></tr></thead>
            <tbody><tr><td>{{ st.M | escape }}</td><td>{{ st.T | escape }}</td><td>{{ st.SV | escape }}</td><td>{{ st.W | escape }}</td><td>{{ st.LD | escape }}</td><td>{{ st.OC | escape }}</td></tr></tbody>
          </table>
          {%- endfor -%}
          {%- if wu.keywords.size > 0 -%}
          <dl><dt>Keywords</dt><dd><ul class="xg-class__chips xg-unit__kw">{% for k in wu.keywords %}<li><button type="button" class="xg-chip" data-wkind="keyword" data-value="{{ k | escape }}" title="Other {{ wh_army }} {{ k | escape }} units in stock">{{ k | escape }}</button></li>{% endfor %}{% for k in wu.factionKeywords %}<li class="xg-unit__kw--f"><button type="button" class="xg-chip" data-wkind="keyword" data-value="{{ k | escape }}" title="Other {{ k | escape }} units in stock">{{ k | escape }}</button></li>{% endfor %}</ul></dd></dl>
          <p class="xg-class__hint">Tap the army, datasheet, size, points or a keyword to see the other boxes we have in stock with it.</p>
          {%- endif -%}
        </aside>
        {%- if wu.weapons.ranged.size > 0 or wu.weapons.melee.size > 0 -%}
        <section class="xg-unit__weapons" aria-label="Weapons">
          <h3 class="xg-class__title">Weapons</h3>
          <div class="xg-unit__scroll">
          <table class="xg-unit__wt">
            <thead><tr><th scope="col">Weapon</th><th scope="col">Range</th><th scope="col">A</th><th scope="col">BS/WS</th><th scope="col">S</th><th scope="col">AP</th><th scope="col">D</th><th scope="col">Abilities</th></tr></thead>
            {%- if wu.weapons.ranged.size > 0 -%}
            <tbody><tr class="xg-unit__wh"><th colspan="8" scope="rowgroup">Ranged</th></tr>
            {%- for w in wu.weapons.ranged -%}<tr><th scope="row">{{ w.name | escape }}</th><td>{{ w.range | escape }}</td><td>{{ w.a | escape }}</td><td>{{ w.skill | escape }}</td><td>{{ w.s | escape }}</td><td>{{ w.ap | escape }}</td><td>{{ w.d | escape }}</td><td>{{ w.kw | escape }}</td></tr>{%- endfor -%}
            </tbody>
            {%- endif -%}
            {%- if wu.weapons.melee.size > 0 -%}
            <tbody><tr class="xg-unit__wh"><th colspan="8" scope="rowgroup">Melee</th></tr>
            {%- for w in wu.weapons.melee -%}<tr><th scope="row">{{ w.name | escape }}</th><td>{{ w.range | escape }}</td><td>{{ w.a | escape }}</td><td>{{ w.skill | escape }}</td><td>{{ w.s | escape }}</td><td>{{ w.ap | escape }}</td><td>{{ w.d | escape }}</td><td>{{ w.kw | escape }}</td></tr>{%- endfor -%}
            </tbody>
            {%- endif -%}
          </table>
          </div>
          <p class="xg-class__hint">Every weapon the datasheet can take, including options; the box may not include all of them.</p>
        </section>
        {%- endif -%}
        {%- endif -%}
        {%- if show_bt -%}
        {%- assign bt_classes = '' -%}{%- assign bt_tech = '' -%}
        {%- for u in btp.units -%}
          {%- unless bt_classes contains u.cls -%}{%- assign bt_classes = bt_classes | append: u.cls | append: '|' -%}{%- endunless -%}
          {%- unless bt_tech contains u.tech -%}{%- assign bt_tech = bt_tech | append: u.tech | append: '|' -%}{%- endunless -%}
        {%- endfor -%}
        <aside class="xg-class xg-bt" aria-label="Box contents">
          <h3 class="xg-class__title">{% if btp.kind == 'salvage' %}Unit specs{% else %}In this box{% endif %}</h3>
          <dl>
            {%- if btp.kind != 'salvage' -%}<dt>ForcePack</dt><dd>{{ btp.pack | escape }}</dd>
            <dt>Units</dt><dd>{{ btp.units.size }} {% if btp.units.size == 1 %}miniature{% else %}miniatures{% endif %}</dd>{%- endif -%}
            {%- assign bt_cl = bt_classes | split: '|' -%}
            {%- if bt_cl.size > 0 -%}
            <dt>Weight {% if bt_cl.size > 1 %}classes{% else %}class{% endif %}</dt>
            <dd><ul class="xg-class__chips">{% for c in bt_cl %}{% if c != blank %}<li><span class="xg-bt__cls xg-bt__cls--{{ c | handleize }}">{{ c }}</span></li>{% endif %}{% endfor %}</ul></dd>
            {%- endif -%}
            <dt>Tech base</dt><dd>{{ bt_tech | split: '|' | join: ' / ' }}</dd>
          </dl>
        </aside>
        <section class="xg-bt__units" aria-label="Units">
          <h3 class="xg-class__title">{% if btp.kind == 'salvage' %}Stats{% else %}The units{% endif %}</h3>
          <div class="xg-bt__scroll">
          <table class="xg-bt__table">
            <thead><tr><th>Unit</th><th>Tons</th><th>Class</th><th title="Walk / Run / Jump">Move</th><th>Role</th><th>Tech</th><th>Year</th></tr></thead>
            <tbody>
            {%- for u in btp.units -%}
            <tr>
              <td class="xg-bt__name">{% if u.mul %}<a href="https://masterunitlist.info/Unit/Details/{{ u.mul }}" target="_blank" rel="noopener" title="Master Unit List">{{ u.name | escape }}</a>{% else %}{{ u.name | escape }}{% endif %}{% if u.model != blank %}<span>{{ u.model | escape }}</span>{% endif %}{% if u.type != 'BattleMech' %}<span>{{ u.type | escape }}</span>{% endif %}</td>
              <td>{% if u.tons %}{{ u.tons }}{% else %}&ndash;{% endif %}</td>
              <td>{% if u.cls != blank %}<span class="xg-bt__cls xg-bt__cls--{{ u.cls | handleize }}">{{ u.cls }}</span>{% else %}&ndash;{% endif %}</td>
              <td>{{ u.walk }}/{{ u.run }}{% if u.jump > 0 %}/{{ u.jump }}{% endif %}</td>
              <td>{{ u.role | escape }}</td>
              <td>{{ u.tech }}</td>
              <td>{{ u.year }}</td>
            </tr>
            {%- endfor -%}
            </tbody>
          </table>
          </div>
          <p class="xg-class__hint">Move is walk / run / jump in hexes. Stats are for the standard variant; the Alpha Strike cards in the box may show another.</p>
        </section>
        {%- endif -%}
        {%- if show_class -%}
        <aside class="xg-class" aria-label="Classification">
          <h3 class="xg-class__title">Classification</h3>
          <dl>
            <dt>Type</dt><dd>{% if gf.base_game.value != blank %}Expansion{% else %}Board game{% endif %}</dd>
            {%- if gf.categories.value != blank -%}
            <dt>Category</dt><dd><ul class="xg-class__chips">{% for c in gf.categories.value %}<li><button type="button" class="xg-chip" data-kind="category" data-value="{{ c | escape }}" title="Other {{ c | escape }} games in stock">{{ c | escape }}</button></li>{% endfor %}</ul></dd>
            {%- endif -%}
            {%- if gf.mechanics.value != blank -%}
            <dt>Mechanism</dt><dd><ul class="xg-class__chips">{% for m in gf.mechanics.value %}<li><button type="button" class="xg-chip" data-kind="mechanism" data-value="{{ m | escape }}" title="Other games with {{ m | escape }} in stock">{{ m | escape }}</button></li>{% endfor %}</ul></dd>
            {%- endif -%}
          </dl>
        </aside>
        {%- endif -%}
      </div>
      <style>
        .xg-desc--split { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 24px 32px; align-items: start; }
        @media (max-width: 767px) { .xg-desc--split { grid-template-columns: 1fr; } }
        .xg-desc--split.xg-desc--solo { grid-template-columns: 1fr; }
        .xg-class.xg-class--meta { margin: 18px 0 0; max-width: 520px; }
        .xg-desc__text { font-size: 15.5px; line-height: 1.6; color: var(--xg-text, #3d454b); }
        .xg-desc__note { margin: 12px 0 0; font-size: 12.5px; color: var(--xg-muted, #8a9299); }
        .xg-desc__note a { color: inherit; text-decoration: underline; }
        .xg-class { padding: 16px 18px; background: var(--xg-bg, #f1f4f6); border-radius: var(--xg-radius, 14px); }
        /* dark: the theme's own h3 colour outranks --xg-ink here and left the card
           titles ("Kit specs", "Product specs", "Classification") dark on dark */
        html[data-xg-theme="dark"] .xg-class .xg-class__title { color: #e6ebee !important; }
        .xg-class__title { margin: 0 0 4px; font-family: var(--xg-font-display, Oswald, Impact, sans-serif); font-size: 17px; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; color: var(--xg-ink, #10171a); }
        .xg-class dl { margin: 0; }
        .xg-class dt { margin: 12px 0 5px; font-size: 11.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--xg-muted, #8a9299); }
        .xg-class dd { margin: 0; font-size: 14px; font-weight: 600; color: var(--xg-ink, #10171a); }
        .xg-class__chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
        .xg-class__chips li { margin: 0; padding: 0; list-style: none; }
        .xg-chip { margin: 0; padding: 3px 9px; border-radius: 999px; background: var(--xg-surface, #fff); border: 1px solid var(--xg-border, #e3e7ea); font: inherit; font-size: 12.5px; font-weight: 500; line-height: 1.4; color: var(--xg-text, #4b5560); cursor: pointer; transition: border-color 120ms ease, color 120ms ease; }
        .xg-chip:hover, .xg-chip:focus-visible { border-color: var(--xg-red, #d62c28); color: var(--xg-red, #d62c28); outline: none; }
        .xg-chip::after { content: " \203A"; opacity: .55; }
        .xg-class__hint { margin: 10px 0 0; font-size: 11.5px; color: var(--xg-muted, #8a9299); }
        .xg-class__hint a { color: inherit; text-decoration: underline; }
        /* Warhammer 40K unit specs */
        .xg-unit__tag { display: inline-block; margin-left: 4px; padding: 1px 7px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; background: var(--xg-surface, #fff); border: 1px solid var(--xg-border, #e3e7ea); color: var(--xg-muted, #8a9299); }
        .xg-unit__pts { margin: 0; padding: 0; list-style: none; }
        .xg-unit__pts li { display: flex; justify-content: space-between; gap: 10px; margin: 0 0 3px; padding: 0; list-style: none; font-variant-numeric: tabular-nums; }
        .xg-unit__pts span { font-weight: 500; color: var(--xg-text, #3d454b); }
        .xg-unit__stats { width: 100%; margin: 14px 0 0; border-collapse: collapse; table-layout: fixed; text-align: center; font-variant-numeric: tabular-nums; background: transparent; }
        /* theme.css gives every th/td text-align:left, a 1px border and 10px 14px
           padding, and every table a white background: undo all four here so
           the stat line reads as one centred row (owner, 2026-09-25). */
        .xg-class .xg-unit__stats th, .xg-class .xg-unit__stats td { text-align: center; border: 0; }
        .xg-unit__stats caption { caption-side: top; text-align: left; font-size: 12px; font-weight: 600; color: var(--xg-muted, #8a9299); padding: 0 0 4px; }
        .xg-unit__stats th { padding: 4px 0; font-size: 11px; font-weight: 700; letter-spacing: .06em; color: var(--xg-surface, #fff); background: var(--xg-ink, #10171a); }
        .xg-unit__stats th:first-child { border-radius: 6px 0 0 6px; } .xg-unit__stats th:last-child { border-radius: 0 6px 6px 0; }
        .xg-unit__stats td { padding: 6px 0 2px; font-size: 16px; font-weight: 700; color: var(--xg-ink, #10171a); background: transparent; }
        html[data-xg-theme="dark"] .xg-unit__stats th { background: #e6ebee; color: #14181b; }
        .xg-unit__kw .xg-chip { font-size: 12px; padding: 2px 8px; }
        .xg-unit__kw li.xg-unit__kw--f .xg-chip { border-color: var(--xg-red, #d62c28); color: var(--xg-red, #d62c28); }
        .xg-chip.xg-chip--v { padding: 2px 10px; font-size: 13.5px; font-weight: 600; color: var(--xg-ink, #10171a); }
        .xg-chip.xg-chip--v:hover, .xg-chip.xg-chip--v:focus-visible { color: var(--xg-red, #d62c28); }
        .xg-unit__pts li { align-items: center; }
        .xg-unit__pts .xg-chip--v { font-variant-numeric: tabular-nums; }
        .xg-unit__weapons { grid-column: 1 / -1; min-width: 0; }
        /* BattleTech box contents */
        .xg-bt__units { grid-column: 1 / -1; min-width: 0; }
        .xg-bt__scroll { overflow-x: auto; margin-top: 8px; }
        .xg-class .xg-bt__table, .xg-bt__table { width: 100%; border-collapse: collapse; background: transparent; font-variant-numeric: tabular-nums; }
        .xg-bt__table th, .xg-bt__table td { border: 0; border-bottom: 1px solid var(--xg-border, #e3e7ea); padding: 8px 10px; text-align: center; font-size: 14px; color: var(--xg-ink, #10171a); white-space: nowrap; background: transparent; }
        .xg-bt__table th { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--xg-surface, #fff); background: var(--xg-ink, #10171a); border-bottom: 0; }
        .xg-bt__table th:first-child, .xg-bt__table td:first-child { text-align: left; }
        .xg-bt__table th:first-child { border-radius: 6px 0 0 6px; } .xg-bt__table th:last-child { border-radius: 0 6px 6px 0; }
        html[data-xg-theme="dark"] .xg-bt__table th { background: #e6ebee; color: #14181b; }
        .xg-bt__name { font-weight: 700; }
        .xg-bt__name a { color: inherit; text-decoration: none; border-bottom: 1px dotted currentColor; }
        .xg-bt__name a:hover { color: var(--xg-red, #d62c28); }
        .xg-bt__name span { display: inline-block; margin-left: 6px; font-size: 12px; font-weight: 500; color: var(--xg-muted, #8a9299); }
        .xg-bt__cls { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; color: #fff; background: #6b7780; }
        .xg-bt__cls--light { background: #2f8f5b; } .xg-bt__cls--medium { background: #2d6fb0; }
        .xg-bt__cls--heavy { background: #c77a1a; } .xg-bt__cls--assault { background: #b3261e; }
        .xg-bt__cls--superheavy { background: #6e2a8c; } .xg-bt__cls--ultralight { background: #5f8f2f; }
        /* Wide screens: the weapons table sits in the left column beside the
           Unit specs card (under the description when there is one; at the
           top when the box has none, instead of below an empty gap). */
        @media (min-width: 768px) {
          .xg-desc--wh .xg-unit { grid-column: 2; grid-row: 1 / span 2; }
          .xg-desc--wh .xg-unit__weapons { grid-column: 1; grid-row: 2; }
          .xg-desc--wh-bare .xg-unit__weapons { grid-row: 1; }
          .xg-desc--wh-bare .xg-unit__weapons > .xg-class__title { margin-top: 0; }
        }
        .xg-unit__wt { background: transparent; margin: 0; }
        .xg-desc--wh-bare .xg-desc__body { display: none; }
        .xg-unit__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 8px; border: 1px solid var(--xg-border, #e3e7ea); border-radius: var(--xg-radius, 14px); }
        .xg-unit__wt { width: 100%; min-width: 620px; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
        .xg-unit__wt th, .xg-unit__wt td { padding: 7px 10px; text-align: center; border-bottom: 1px solid var(--xg-border, #e3e7ea); color: var(--xg-text, #3d454b); }
        .xg-unit__wt thead th { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--xg-muted, #8a9299); background: var(--xg-bg, #f1f4f6); }
        .xg-unit__wt tbody th[scope="row"], .xg-unit__wt thead th:first-child { text-align: left; font-weight: 600; color: var(--xg-ink, #10171a); }
        .xg-unit__wt td:last-child, .xg-unit__wt thead th:last-child { text-align: left; }
        .xg-unit__wt td:last-child { font-size: 12.5px; }
        .xg-unit__wh th { text-align: left !important; font-size: 11.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--xg-red, #d62c28) !important; background: transparent; }
        .xg-unit__wt tbody tr:last-child > * { border-bottom: 0; }
        /* the "games like this" panel */
        .xg-like { position: fixed; inset: 0; z-index: 10050; background: rgba(12, 16, 20, .62); display: flex; align-items: flex-start; justify-content: center; padding: 6vh 16px 16px; overflow-y: auto; }
        .xg-like[hidden] { display: none; }
        .xg-like__panel { width: min(1040px, 100%); background: var(--xg-surface, #fff); color: var(--xg-text, #3d454b); border-radius: var(--xg-radius, 14px); box-shadow: 0 30px 80px rgba(0, 0, 0, .35); padding: 18px 20px 22px; }
        .xg-like__head { display: flex; align-items: center; gap: 12px; margin: 0 0 4px; }
        .xg-like__head h3 { flex: 1 1 auto; margin: 0; font-family: var(--xg-font-display, Oswald, Impact, sans-serif); font-size: 22px; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; color: var(--xg-ink, #10171a); }
        .xg-like__close { flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--xg-border, #e3e7ea); background: var(--xg-bg, #f1f4f6); color: var(--xg-ink, #10171a); font-size: 22px; line-height: 1; cursor: pointer; }
        .xg-like__sub { margin: 0 0 14px; font-size: 13px; color: var(--xg-muted, #8a9299); }
        .xg-like__pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px; margin: 4px 0 14px; }
        .xg-like__pager[hidden] { display: none; }
        .xg-like__grid + .xg-like__pager { margin: 16px 0 4px; }
        .xg-like__pager button { min-width: 36px; height: 36px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--xg-border, #e3e7ea); background: var(--xg-surface, #fff); color: var(--xg-ink, #10171a); font: 600 14px/1 var(--xg-font-body, inherit); cursor: pointer; }
        .xg-like__pager button:hover:not([disabled]) { border-color: var(--xg-red, #d62c28); color: var(--xg-red, #d62c28); }
        .xg-like__pager button[aria-current="page"] { background: var(--xg-red, #d62c28); border-color: var(--xg-red, #d62c28); color: #fff; opacity: 1; cursor: default; }
        .xg-like__pager button[disabled]:not([aria-current]) { opacity: .35; cursor: default; }
        .xg-like__pager button[aria-label] { font-size: 20px; }
        .xg-like__gap { color: var(--xg-muted, #8a9299); padding: 0 2px; }
        .xg-like__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
        .xg-like__card { display: flex; flex-direction: column; background: var(--xg-bg, #f1f4f6); border: 1px solid var(--xg-border, #e3e7ea); border-radius: 12px; padding: 10px 10px 12px; text-align: center; }
        .xg-like__card a { color: inherit; text-decoration: none; }
        .xg-like__card img { width: 100%; aspect-ratio: 1; object-fit: contain; background: #fff; border-radius: 8px; display: block; }
        .xg-like__noimg { width: 100%; aspect-ratio: 1; border-radius: 8px; background: var(--xg-surface, #fff); }
        .xg-like__t { display: block; margin-top: 8px; font-size: 13px; font-weight: 600; line-height: 1.3; color: var(--xg-ink, #10171a); min-height: 2.6em; }
        .xg-like__m { display: block; margin-top: 3px; font-size: 11.5px; color: var(--xg-muted, #8a9299); }
        .xg-like__p { display: block; margin-top: 4px; font-size: 15px; font-weight: 700; color: var(--xg-ink, #10171a); font-variant-numeric: tabular-nums; }
        .xg-like__add { margin-top: 8px; padding: 7px 10px; border: 0; border-radius: 8px; background: var(--xg-red, #d62c28); color: #fff; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; }
        .xg-like__add[disabled] { background: #2a9d5c; cursor: default; }
        .xg-like__empty { padding: 26px 10px; text-align: center; color: var(--xg-muted, #8a9299); }
        html[data-xg-theme="dark"] .xg-like__card img { background: #23292e; }
        @media (max-width: 640px) { .xg-like { padding: 0; align-items: stretch; } .xg-like__panel { border-radius: 0; min-height: 100%; } .xg-like__grid { grid-template-columns: repeat(2, 1fr); } }
      </style>
      {%- if show_class -%}
      <p class="xg-class__hint">Tap a category or mechanism to see the other games we have in stock with it.</p>
      {%- endif -%}
      {%- if show_class or show_wh -%}
      <script>
        (function () {
          if (window.__xgLike) return; window.__xgLike = 1;
          var W = 'https://exor-binder.nevski.workers.dev';
          var here = (document.querySelector('[data-xg-handle]') || {}).getAttribute ? document.querySelector('[data-xg-handle]').getAttribute('data-xg-handle') : '';
          function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
          var box = null;
          function panel() {
            if (box) return box;
            box = document.createElement('div');
            box.className = 'xg-like'; box.hidden = true; box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true');
            box.innerHTML = '<div class="xg-like__panel"><div class="xg-like__head"><h3 id="xg-like-title"></h3><button type="button" class="xg-like__close" aria-label="Close">&times;</button></div><p class="xg-like__sub"></p><nav class="xg-like__pager" aria-label="Pages" hidden></nav><div class="xg-like__grid"></div><nav class="xg-like__pager" aria-label="Pages" hidden></nav></div>';
            box.setAttribute('aria-labelledby', 'xg-like-title');
            document.body.appendChild(box);
            box.addEventListener('click', function (e) { if (e.target === box || (e.target.closest && e.target.closest('.xg-like__close'))) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) close(); });
            box.addEventListener('click', function (e) {
              var b = e.target.closest && e.target.closest('.xg-like__add');
              if (b && !b.disabled) addToCart(b);
              var pg = e.target.closest && e.target.closest('.xg-like__pager [data-page]');
              if (pg && !pg.disabled && lastLoad) {
                lastLoad(+pg.getAttribute('data-page'));
                var pan = box.querySelector('.xg-like__panel');
                if (pan) pan.scrollTop = 0;
                box.scrollTop = 0;
              }
            });
            return box;
          }
          /* Pages of PER results (owner, 2026-09-25: "there is no way to go beyond the
             first page of 36 results: should have arrows and page numbers at top and
             bottom"). The worker answers ?offset=; count is the full total. */
          var PER = 36, lastLoad = null;
          function pagers(p, count, page) {
            var pages = Math.ceil(count / PER), navs = p.querySelectorAll('.xg-like__pager');
            var html = '';
            if (pages > 1) {
              var nums = [], i;
              for (i = 0; i < pages; i++) if (i === 0 || i === pages - 1 || Math.abs(i - page) <= 1) nums.push(i);
              html += '<button type="button" data-page="' + (page - 1) + '" aria-label="Previous page"' + (page === 0 ? ' disabled' : '') + '>&lsaquo;</button>';
              for (i = 0; i < nums.length; i++) {
                if (i && nums[i] - nums[i - 1] > 1) html += '<span class="xg-like__gap">&hellip;</span>';
                html += '<button type="button" data-page="' + nums[i] + '"' + (nums[i] === page ? ' aria-current="page" disabled' : '') + '>' + (nums[i] + 1) + '</button>';
              }
              html += '<button type="button" data-page="' + (page + 1) + '" aria-label="Next page"' + (page >= pages - 1 ? ' disabled' : '') + '>&rsaquo;</button>';
            }
            for (var k = 0; k < navs.length; k++) { navs[k].innerHTML = html; navs[k].hidden = !html; }
          }
          function pageNote(count, page) {
            var pages = Math.ceil(count / PER);
            return pages > 1 ? ' Page ' + (page + 1) + ' of ' + pages + '.' : '';
          }
          function loading(p) {
            p.querySelector('.xg-like__sub').textContent = 'Looking…';
            p.querySelector('.xg-like__grid').innerHTML = '';
            var navs = p.querySelectorAll('.xg-like__pager');
            for (var k = 0; k < navs.length; k++) navs[k].hidden = true;
          }
          function close() { if (!box) return; box.hidden = true; document.body.style.overflow = ''; }
          function sizeLabel(v) { var m = String(v).split('-'); return m.length > 1 ? m[0] + '–' + m[1] + ' models' : (m[0] === '1' ? '1 model' : m[0] + ' models'); }
          function openUnits(kind, value, army, page) {
            page = page || 0;
            lastLoad = function (pg) { openUnits(kind, value, army, pg); };
            var p = panel();
            var t = kind === 'army' ? value + ' in stock'
              : kind === 'datasheet' ? value + ' boxes in stock'
              : kind === 'size' ? army + ' units of ' + sizeLabel(value) + ' in stock'
              : kind === 'points' ? army + ' units around ' + value + ' pts in stock'
              : (army && army !== value ? army + ' ' : '') + value + ' units in stock';
            p.querySelector('#xg-like-title').textContent = t;
            loading(p);
            p.hidden = false; document.body.style.overflow = 'hidden';
            fetch(W + '/w40k/like.json?kind=' + encodeURIComponent(kind) + '&value=' + encodeURIComponent(value) + '&army=' + encodeURIComponent(army || '') + '&exclude=' + encodeURIComponent(here) + '&limit=' + PER + '&offset=' + (page * PER))
              .then(function (r) { return r.json(); })
              .then(function (j) {
                if (p.hidden) return;
                var units = (j && j.ok && j.units) || [];
                var sub = p.querySelector('.xg-like__sub'), grid = p.querySelector('.xg-like__grid');
                if (!units.length) { sub.textContent = ''; grid.innerHTML = '<div class="xg-like__empty">Nothing else like that is in stock right now.</div>'; return; }
                sub.textContent = j.count + (j.count === 1 ? ' box' : ' boxes') + ' on the shelf at Exor Games' + (kind === 'points' ? ', closest in points first' : '') + '.' + pageNote(j.count, page);
                pagers(p, j.count, page);
                grid.innerHTML = units.map(function (u) {
                  var meta = [];
                  if (u.datasheet && kind !== 'datasheet') meta.push(u.datasheet);
                  if (u.points) meta.push(u.points + ' pts');
                  if (u.size) meta.push(sizeLabel(u.size));
                  if (kind === 'datasheet' && u.army) meta.unshift(u.army);
                  return card(u, meta);
                }).join('');
              })
              .catch(function () { if (!p.hidden) p.querySelector('.xg-like__sub').textContent = 'Could not load the list right now.'; });
          }
          function card(g, meta) {
            return '<div class="xg-like__card"><a href="' + esc(g.url) + '">' +
              (g.image ? '<img src="' + esc(g.image) + '" alt="' + esc(g.title) + '" loading="lazy">' : '<div class="xg-like__noimg"></div>') +
              '<span class="xg-like__t">' + esc(g.title) + '</span>' +
              '<span class="xg-like__m">' + esc(meta.join(' · ')) + '</span>' +
              '<span class="xg-like__p">$' + esc(g.price) + '</span></a>' +
              (g.variant ? '<button type="button" class="xg-like__add" data-variant="' + esc(g.variant) + '" data-title="' + esc(g.title) + '" data-image="' + esc(g.image || '') + '" data-url="' + esc(g.url) + '" data-cents="' + esc(Math.round(Number(g.price) * 100)) + '">Add to cart</button>' : '') +
              '</div>';
          }
          function open(kind, value, page) {
            page = page || 0;
            lastLoad = function (pg) { open(kind, value, pg); };
            var p = panel();
            p.querySelector('#xg-like-title').textContent = (kind === 'mechanism' ? 'Games with ' : '') + value + (kind === 'category' ? ' games' : '') + ' in stock';
            loading(p);
            p.hidden = false; document.body.style.overflow = 'hidden';
            fetch(W + '/games/like.json?kind=' + encodeURIComponent(kind) + '&value=' + encodeURIComponent(value) + '&exclude=' + encodeURIComponent(here) + '&limit=' + PER + '&offset=' + (page * PER))
              .then(function (r) { return r.json(); })
              .then(function (j) {
                if (p.hidden) return;
                var games = (j && j.ok && j.games) || [];
                var sub = p.querySelector('.xg-like__sub'), grid = p.querySelector('.xg-like__grid');
                if (!games.length) { sub.textContent = ''; grid.innerHTML = '<div class="xg-like__empty">Nothing else with ' + esc(value) + ' is in stock right now.</div>'; return; }
                sub.textContent = j.count + (j.count === 1 ? ' game' : ' games') + ' on the shelf at Exor Games, best rated first.' + pageNote(j.count, page) + ' Board game data from BoardGameGeek.';
                pagers(p, j.count, page);
                grid.innerHTML = games.map(function (g) {
                  var meta = [];
                  if (g.rating) meta.push('BGG ' + Number(g.rating).toFixed(1));
                  if (g.players) meta.push(g.players + ' players');
                  if (g.time) meta.push(g.time + ' min');
                  return '<div class="xg-like__card"><a href="' + esc(g.url) + '">' +
                    (g.image ? '<img src="' + esc(g.image) + '" alt="' + esc(g.title) + '" loading="lazy">' : '<div class="xg-like__noimg"></div>') +
                    '<span class="xg-like__t">' + esc(g.title) + '</span>' +
                    '<span class="xg-like__m">' + esc(meta.join(' · ')) + '</span>' +
                    '<span class="xg-like__p">$' + esc(g.price) + '</span></a>' +
                    (g.variant ? '<button type="button" class="xg-like__add" data-variant="' + esc(g.variant) + '" data-title="' + esc(g.title) + '" data-image="' + esc(g.image || '') + '" data-url="' + esc(g.url) + '" data-cents="' + esc(Math.round(Number(g.price) * 100)) + '">Add to cart</button>' : '') +
                    '</div>';
                }).join('');
              })
              .catch(function () { if (!p.hidden) p.querySelector('.xg-like__sub').textContent = 'Could not load the list right now.'; });
          }
          function addToCart(b) {
            b.disabled = true; b.textContent = 'Adding…';
            fetch('/cart/add.js', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ id: Number(b.getAttribute('data-variant')), quantity: 1 }) })
              .then(function (r) { if (!r.ok) throw new Error('cart ' + r.status); return r.json(); })
              .then(function (it) {
                b.textContent = 'Added ✓';
                try { var sync = (window.Shopify && window.Shopify.adjustCartDropDown) || window.adjustCartDropDown; if (typeof sync === 'function') sync(); } catch (e) {}
                if (window.xgCartPeek) window.xgCartPeek({ title: b.getAttribute('data-title'), image: b.getAttribute('data-image'), url: b.getAttribute('data-url'), qty: 1, cents: Number((it && it.final_price) || b.getAttribute('data-cents')) });
              })
              .catch(function () { b.disabled = false; b.textContent = 'Try again'; });
          }
          document.addEventListener('click', function (e) {
            var w = e.target.closest && e.target.closest('.xg-chip[data-wkind]');
            if (w) {
              e.preventDefault();
              var a = w.closest('[data-army]');
              openUnits(w.getAttribute('data-wkind'), w.getAttribute('data-value'), a ? a.getAttribute('data-army') : '');
              return;
            }
            var c = e.target.closest && e.target.closest('.xg-chip[data-kind]');
            if (!c) return;
            e.preventDefault();
            open(c.getAttribute('data-kind'), c.getAttribute('data-value'));
          });
        })();
        /* Board games: on wide screens the Classification card sits in the buy
           column, under the Add to cart / payment buttons (owner, 2026-09-25,
           screenshot of I Feel Attacked: "for boardgames, this could go there"),
           and the description takes the full width. Phones keep it where it
           was. Chip clicks are delegated on document, so they follow it. */
        (function () {
          var card = document.querySelector('.xg-desc aside.xg-class[aria-label="Classification"]');
          var meta = document.querySelector('.product-single-right .product-single__meta') || document.querySelector('.product-single__meta');
          if (!card || !meta || !window.matchMedia) return;
          var home = card.parentNode, next = card.nextSibling, desc = card.closest('.xg-desc');
          var mq = window.matchMedia('(min-width: 768px)');
          function place() {
            if (mq.matches && card.parentNode !== meta) {
              meta.appendChild(card);
              card.classList.add('xg-class--meta');
              if (desc && !desc.querySelector('aside, .xg-bt__units, .xg-unit__weapons')) desc.classList.add('xg-desc--solo');
            } else if (!mq.matches && card.parentNode !== home) {
              home.insertBefore(card, next);
              card.classList.remove('xg-class--meta');
              if (desc) desc.classList.remove('xg-desc--solo');
            }
          }
          place();
          if (mq.addEventListener) mq.addEventListener('change', place); else if (mq.addListener) mq.addListener(place);
        })();
      </script>
      {%- endif -%}
      {%- else -%}
      {{ product.description }}
      {%- endif -%}
    </div>
    {% endif %}
    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'policy' %}
    <div id="{{block.settings.policy_page}}" class="tab-pane fade in" role="tabpanel">
      <div class="policy">
        <div class="refund">
          <div class="inner-content">{{ shop[block.settings.policy_page] }}</div>
        </div>
      </div>
    </div>
    {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
"name":"Information Tabs",
"settings":[
{
"type":"checkbox",
"id":"show_description",
"label":"Show Description Tab",
"default":true
},
{
"type": "paragraph",
"content": "Looking to add other tabs? Try adding a block."
}
],
"blocks":[
{
"type": "policy",
"name": "Policy Page",
"settings": [
{
"type": "header",
"content": "Add a section page to the tabs"
},
{
"type": "select",
"id": "policy_page",
"label": "Select a policy template for this block",
"default": "refund_policy",
"options": [
{
"value": "refund_policy",
"label": "Refund Policy"
},
{
"value": "privacy_policy",
"label": "Privacy Policy"
},
{
"value": "terms_of_service",
"label": "Terms of Service"
}
]
}
]
}
],
"presets":[
{
"name":"Add Information Tabs Snippet",
"blocks": [
{
"type": "policy"
}
]
}
],
"templates":["product"]
}
{% endschema %}
