  <script>
    /* Dark mode boot — must run before the stylesheets paint. DARK IS THE
       DEFAULT (owner, 2026-09-16): the only way to get the light skin is to
       ask for it with the header sun/moon button, which stores
       localStorage.xgTheme = 'light'. The device's own preference is no
       longer consulted — it used to decide for shoppers who had not chosen.
       xg-dark.css keys everything on this attribute, and xg-theme-toggle.js
       owns the header button. */
    (function () {
      try {
        if (localStorage.getItem('xgTheme') !== 'light') {
          document.documentElement.setAttribute('data-xg-theme', 'dark');
        }
      } catch (e) {
        document.documentElement.setAttribute('data-xg-theme', 'dark');
      }
    })();
  </script>
