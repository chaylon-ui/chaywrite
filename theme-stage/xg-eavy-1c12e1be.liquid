{%- comment -%}
  "Paint it like the box" (owner 2026-09-25: "Can you use this website to help
  suggest paints on Warhammer products with direct links to the paints on our
  site for sale https://eavy-archive.com/40k/adeptus-mechanicus/").

  The worker (chaywrite src/eavy.js, /eavy/for.json) picks the 'Eavy Archive
  army page and box-art scheme for this product - a character or chapter the
  title names first, else the army from the 40K unit facts or the title - and
  resolves every paint each area uses to our own Citadel listing. Only the
  paint NAMES come from 'Eavy Archive; the method (steps, ratios, photos)
  stays on their site, linked per scheme and per area, with a credit.
  No scheme found -> the card stays hidden.

  Params: product, faction (exor.wh_unit faction, may be blank).
{%- endcomment -%}
{%- liquid
  assign ptype = product.type | downcase
  assign skip = false
  if ptype contains 'paint' or ptype contains 'hobby' or ptype contains 'book' or ptype contains 'dice' or ptype contains 'accessor' or ptype contains 'tool'
    assign skip = true
  endif
-%}
{%- unless skip -%}
<section class="xg-eavy" hidden aria-label="Paint it like the box" data-title="{{ product.title | escape }}" data-faction="{{ faction | escape }}">
  <div class="xg-eavy__head">
    <h3 class="xg-eavy__title">Paint it like the box</h3>
    <p class="xg-eavy__sub">The paints for the <span class="xg-eavy__army"></span> box-art scheme, straight from our shelves.</p>
  </div>
  <div class="xg-eavy__pick"></div>
  <div class="xg-eavy__areas"></div>
  <div class="xg-eavy__foot">
    <button type="button" class="xg-eavy__add"></button>
    <a class="xg-eavy__how" target="_blank" rel="noopener">Full step-by-step on &lsquo;Eavy Archive &#8599;</a>
    <span class="xg-eavy__msg" role="status"></span>
  </div>
  <p class="xg-eavy__credit">Paint lists from <a href="https://eavy-archive.com/" target="_blank" rel="noopener">&lsquo;Eavy Archive</a>, box-art recipes collected by The Infernal Brush Discord community (unofficial, not endorsed by Games Workshop). Paints not in the Citadel range are shown without a link.</p>
</section>
<style>
  .xg-eavy { margin: 26px 0 0; padding: 18px 20px 16px; border: 1px solid var(--xg-border, #e3e7ea); border-radius: 14px; background: var(--xg-surface-2, rgba(127,127,127,.05)); }
  .xg-eavy__head { margin: 0 0 12px; }
  .xg-desc .xg-eavy__title, .xg-eavy__title { margin: 0 0 4px; font-family: inherit; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--xg-ink, #171b1d) !important; }
  .xg-eavy__sub { margin: 0; font-size: 14px; color: var(--xg-muted, #6b757c); }
  .xg-eavy__pick { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
  .xg-eavy__pick button { padding: 6px 12px; border: 1px solid var(--xg-border, #d5dbe0); border-radius: 999px; background: transparent; color: var(--xg-text, #3d454b); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  .xg-eavy__pick button[aria-pressed="true"] { border-color: var(--xg-red, #d62c28); background: var(--xg-red, #d62c28); color: #fff; }
  .xg-eavy__pick select { max-width: 100%; padding: 7px 10px; border: 1px solid var(--xg-border, #d5dbe0); border-radius: 8px; background: var(--xg-surface, #fff); color: var(--xg-text, #3d454b); font: inherit; font-size: 14px; }
  .xg-eavy__areas { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px 18px; }
  .xg-eavy__area { min-width: 0; }
  .xg-eavy__an { display: flex; align-items: baseline; gap: 8px; margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--xg-muted, #6b757c); }
  .xg-eavy__an a { font-weight: 500; letter-spacing: 0; text-transform: none; color: inherit; text-decoration: underline; opacity: .8; }
  .xg-eavy__chips { display: flex; flex-wrap: wrap; gap: 5px; margin: 0; padding: 0; list-style: none; }
  .xg-eavy__chips li { margin: 0; padding: 0; list-style: none; }
  .xg-eavy__p { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px 4px 5px; border: 1px solid var(--xg-border, #d5dbe0); border-radius: 999px; background: var(--xg-surface, #fff); color: var(--xg-text, #3d454b); font-size: 13px; line-height: 1.3; text-decoration: none; }
  a.xg-eavy__p:hover { border-color: var(--xg-red, #d62c28); }
  .xg-eavy__sw { flex: 0 0 auto; width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgba(0,0,0,.18); background: #bbb; }
  .xg-eavy__pr { color: var(--xg-muted, #8a9299); font-size: 12px; }
  .xg-eavy__p.is-out { opacity: .6; }
  .xg-eavy__p.is-na { padding-left: 9px; border-style: dashed; color: var(--xg-muted, #8a9299); background: transparent; }
  .xg-eavy__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin: 16px 0 0; }
  .xg-eavy__add { padding: 9px 14px; border: 0; border-radius: 9px; background: var(--xg-red, #d62c28); color: #fff; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; }
  .xg-eavy__add[disabled] { opacity: .7; cursor: default; }
  .xg-eavy__how { font-size: 14px; font-weight: 600; color: var(--xg-ink, #171b1d); text-decoration: underline; }
  .xg-eavy__msg { font-size: 13.5px; color: var(--xg-muted, #6b757c); }
  .xg-eavy__msg a { color: inherit; text-decoration: underline; }
  .xg-eavy__credit { margin: 12px 0 0; font-size: 12px; line-height: 1.5; color: var(--xg-muted, #8a9299); }
  .xg-eavy__credit a { color: inherit; text-decoration: underline; }
  html[data-xg-theme="dark"] .xg-eavy__title { color: #eef1f3 !important; }
  html[data-xg-theme="dark"] .xg-eavy__p { background: #1d2327; border-color: #394248; color: #dde3e7; }
  html[data-xg-theme="dark"] .xg-eavy__p.is-na { background: transparent; color: #9aa6ad; }
  html[data-xg-theme="dark"] .xg-eavy__how { color: #eef1f3; }
  html[data-xg-theme="dark"] .xg-eavy__pick button { border-color: #394248; color: #dde3e7; }
  html[data-xg-theme="dark"] .xg-eavy__pick button[aria-pressed="true"] { border-color: var(--xg-red, #d62c28); color: #fff; }
  html[data-xg-theme="dark"] .xg-eavy__pick select { background: #1d2327; border-color: #394248; color: #dde3e7; }
  @media (max-width: 640px) { .xg-eavy { padding: 14px 14px 12px; } .xg-eavy__areas { grid-template-columns: 1fr; } }
</style>
<script>
  (function () {
    var box = document.currentScript && document.currentScript.previousElementSibling && document.currentScript.previousElementSibling.previousElementSibling;
    if (!box || !box.classList || !box.classList.contains('xg-eavy') || !window.fetch) return;
    var W = 'https://exor-binder.nevski.workers.dev';
    var data = null, cur = 0;
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function money(p) { return '$' + (Number(p) || 0).toFixed(2); }
    function $(s) { return box.querySelector(s); }

    function chip(p) {
      if (!p.handle) return '<li><span class="xg-eavy__p is-na" title="Not a Citadel paint we list">' + esc(p.name) + '</span></li>';
      return '<li><a class="xg-eavy__p' + (p.a ? '' : ' is-out') + '" href="/products/' + encodeURIComponent(p.handle) + '" title="' + esc(p.title) + (p.a ? '' : ' - sold out') + '">' +
        '<span class="xg-eavy__sw"' + (p.h ? ' style="background:' + esc(p.h) + '"' : '') + '></span>' + esc(p.name) +
        '<span class="xg-eavy__pr">' + (p.a ? money(p.price) : 'sold out') + '</span></a></li>';
    }
    function inStock(s) {
      var seen = {}, out = [];
      s.areas.forEach(function (ar) { ar.paints.forEach(function (p) { if (p.handle && p.a && p.v && !seen[p.v]) { seen[p.v] = 1; out.push(p); } }); });
      return out;
    }
    function show(i) {
      cur = i;
      var s = data.schemes[i];
      [].forEach.call(box.querySelectorAll('.xg-eavy__pick button'), function (b) { b.setAttribute('aria-pressed', String(+b.getAttribute('data-i') === i)); });
      var sel = $('.xg-eavy__pick select'); if (sel) sel.value = String(i);
      $('.xg-eavy__areas').innerHTML = s.areas.map(function (ar) {
        return '<div class="xg-eavy__area"><h4 class="xg-eavy__an">' + esc(ar.name) + ' <a href="' + esc(ar.url) + '" target="_blank" rel="noopener" title="How to paint the ' + esc(ar.name) + ' on ‘Eavy Archive">how &#8599;</a></h4>' +
          '<ul class="xg-eavy__chips">' + ar.paints.map(chip).join('') + '</ul></div>';
      }).join('');
      $('.xg-eavy__how').href = s.url;
      var n = inStock(s).length, add = $('.xg-eavy__add');
      add.hidden = !n; add.disabled = false;
      add.textContent = 'Add the ' + n + ' in-stock paint' + (n === 1 ? '' : 's') + ' to cart';
      $('.xg-eavy__msg').textContent = '';
    }
    function added(ok) {
      var add = $('.xg-eavy__add');
      add.disabled = false;
      $('.xg-eavy__msg').innerHTML = ok ? 'Added to your cart. <a href="/cart">View cart</a>' : 'Could not add them - please try again.';
      if (ok) {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        try { var sync = (window.Shopify && window.Shopify.adjustCartDropDown) || window.adjustCartDropDown; if (typeof sync === 'function') sync(); } catch (e) {}
      }
    }
    function post(items) {
      return fetch('/cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function (r) { return r.ok; }, function () { return false; });
    }
    box.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('.xg-eavy__pick button');
      if (b) return show(+b.getAttribute('data-i'));
      if (!(e.target.closest && e.target.closest('.xg-eavy__add'))) return;
      var list = inStock(data.schemes[cur]);
      if (!list.length) return;
      $('.xg-eavy__add').disabled = true; $('.xg-eavy__msg').textContent = 'Adding…';
      post(list.map(function (p) { return { id: p.v, quantity: 1 }; })).then(function (ok) {
        if (ok) return added(true);
        // one pot just sold out: add the rest one by one
        var any = false;
        list.reduce(function (q, p) { return q.then(function () { return post([{ id: p.v, quantity: 1 }]).then(function (k) { any = any || k; }); }); }, Promise.resolve())
          .then(function () { added(any); });
      });
    });
    box.addEventListener('change', function (e) { if (e.target.tagName === 'SELECT') show(+e.target.value); });

    var u = W + '/eavy/for.json?title=' + encodeURIComponent(box.getAttribute('data-title')) + '&faction=' + encodeURIComponent(box.getAttribute('data-faction') || '');
    fetch(u).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
      if (!d || !d.ok || !d.schemes || !d.schemes.length) return;
      // a scheme is only worth showing when we sell at least one of its paints
      d.schemes = d.schemes.filter(function (s) { return s.areas.some(function (ar) { return ar.paints.some(function (p) { return p.handle; }); }); });
      if (!d.schemes.length) return;
      data = d;
      $('.xg-eavy__army').textContent = d.page.title;
      var pick = $('.xg-eavy__pick');
      if (d.schemes.length > 8) {
        pick.innerHTML = '<label><span class="visually-hidden">Scheme</span><select>' + d.schemes.map(function (s, i) { return '<option value="' + i + '">' + esc(s.name) + '</option>'; }).join('') + '</select></label>';
      } else if (d.schemes.length > 1) {
        pick.innerHTML = d.schemes.map(function (s, i) { return '<button type="button" data-i="' + i + '" aria-pressed="false">' + esc(s.name) + '</button>'; }).join('');
      } else pick.hidden = true;
      show(0);
      box.hidden = false;
    }).catch(function () {});
  })();
</script>
{%- endunless -%}
