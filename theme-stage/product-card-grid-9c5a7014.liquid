<div class="grid-view-item product-{{product.id}}">
  <div class="grid-view-item__link grid-view-item__image-container">
    {% capture img_id %}ProductCardImage-{{ section.id }}-{{ product.id }}{% endcapture %}
    {% capture wrapper_id %}ProductCardImageWrapper-{{ section.id }}-{{ product.id }}{% endcapture %}
    {%- assign img_url = product.featured_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
    {%- assign truncate_desc = settings.show_description -%}
    <div class="grid-view-item__image-wrapper js">
      <a href="{{ product.url | within: collection }}">
        <div class="image-inner">
          <div class="reveal">
            {%if product.type contains 'Single' %}
            <div class="card {% if product.selected_or_first_available_variant.title contains " Foil" %}rainbowFoil{% endif %}">
              <img alt="{{ product.featured_image.alt | escape }}" loading="lazy" src="{{ product.featured_image | image_url: width: 370 }}" srcset="{{ product.featured_image | image_url: width: 370 }} 1x, {{ product.featured_image | image_url: width: 740 }} 2x"/>
              <span id="tag-container"></span>
            </div>
            {% else %}
            <img alt="{{ product.featured_image.alt | escape }}" class="grid-view-item__image lazyload {% unless product.images[1] == blank %} main-img {% endunless %}" loading="lazy" src="{{ product.featured_image | image_url: width: 370 }}" srcset="{{ product.featured_image | image_url: width: 370 }} 1x, {{ product.featured_image | image_url: width: 740 }} 2x"/>


            {% unless product.images[1] == blank %}
            <img alt="{{ product.images[1].alt | escape }}" class="extra-img" loading="lazy" src="{{ product.images[1] | image_url: width: 370 }}" srcset="{{ product.images[1] | image_url: width: 370 }} 1x, {{ product.images[1] | image_url: width: 740 }} 2x"/>
            {% endunless %}

            <span id="tag-container"></span>
            {% endif %}
          </div>
          <div class="hide imgurl-for-quickview">
            {% for image in product.images %}
            <span>{{image | img_url: '771x1000'}}</span>
            {% endfor %}
          </div>
          <div class="hide socialurl-for-quickview">
            <span>
            </span>
          </div>
        </div>
      </a>

      {% if product.compare_at_price > product.price %}
      <div class="product-flags">
        <span class="flag sale">{{ 'products.product.sale' | t }}</span>
      </div>
      {% endif %}
    </div>

    <div class="product-description">
      <span class="custom-dropdown__small">
        <select title="Select variant" last="{{ product.selected_or_first_available_variant.id }}" name="id" data-dropdown-id="productSelect-dropdown" className="collection__select"{% unless product.available %} disabled{% endunless %}>
          {% unless product.available %}
          <option disabled selected value="{{ product.selected_or_first_available_variant.id }}">{{ 'products.product.sold_out' | t }}</option>
          {% endunless %}
          {% for variant in product.variants %}
          <option {% if product.available and variant.id == product.selected_or_first_available_variant.id %} selected="selected" {% endif %}{% unless variant.available %} disabled{% endunless %} value="{{ variant.id }}">
            {% if variant.title == 'Default Title' %}Available{% else %}{{ variant.title }}{% endif %}{% unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
          </option>
          {% endfor %}
        </select>
      </span>
      <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
      <a href="{{ product.url | within: collection }}">
        <div class="product-detail">
          <div class="h4 grid-view-item__title">{{ product.title }}</div>
        </div>
      </a>
      <div class="grid-view-item__meta">
        {% render 'product-price', product:product %}
      </div>
      <div class="product-desc"> {{ product.description | strip_html | truncate: truncate_desc }} </div>
      <div class="thumbnail-buttons">
        <div class="quick-view">
          <button aria-label="Quickview" title="Quickview" class="btn" data-toggle="modal">{% render 'icons' with 'quickview' %}<span> {{
              'products.product.quickview' | t }}</span></button>
        </div>
        {% render 'wishlist-icon', product:product %}
        <div class="product-block-hover grid-hover">
          <div class="qv-cartmain add_to_cart_main grid-cart hide">
            <form action="/cart/add" method="post" class="add-to-cart product-form product-form-{{ section.id }}" data-section="{{ section.id }}">
              <div class="product-selector">
                {% unless product.options.size == 1 and product.variants[0].title == 'Default Title' %}
                {% for option in product.options_with_values %}
                <div class="selector-wrapper js product-form__item">
                  <label {% if option.name=='default' %} class="label--hidden" {% endif %}>
                    {{ option.name }}
                  </label>
                  <select title="Add to cart" class="single-option-selector" data-index="option{{ forloop.index }}">
                    {% for value in option.values %}
                    <option value="{{ value | escape }}" {% if option.selected_value==value %} selected="selected" {% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
                {% endfor %}
                <div class="quickview-swatch">
                  {% for option in product.options_with_values %}
                  <div class="custom-swatch">
                    <label {% if option.name=='default' %}class="label--hidden" {% endif %}>
                      {{ option.name }}
                    </label>
                    <div class="option-swatch" data-selector="option{{ forloop.index }}">
                      {% for value in option.values %}
                      {% if option.name == 'color' or option.name == 'Color'%}
                      <span class="custom-swatch color-swatch{% if option.selected_value == value %} active{% endif %}" style="background-color: {{ value }};" data-index="{{ forloop.index | minus:1}}"></span>
                      {% else %}
                      <span class="custom-swatch{% if option.selected_value == value %} active{% endif %}" data-index="{{ forloop.index | minus:1}}"> {{ value }}</span>
                      {% endif%}
                      {% endfor %}
                    </div>
                  </div>
                  {% endfor %}
                </div>
                {% endunless %}
              </div>
              <select title="Add to cart" name="id" data-section="{{ section.id }}" class="product-form__variants no-js">
                {% for variant in product.variants %}
                <option {% if variant==product.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}" data-available="{% if variant.available %}1{% else %}0{% endif %}" data-price="{{variant.price | money }}" data-compareatprice="{{variant.compare_at_price | money }}" {% unless variant.available %}disabled="disabled" {% endunless %}>{{ variant.title | escape | strip_html
                  | strip_newlines}}</option>
                {% endfor %}
              </select>
              <div class="product-form__item product-form__item--quantity">
                <div class="dec button qtyminus">-</div>
                <input name="quantity" value="1" class="quantity">
                <div class="inc button qtyplus">+</div>
              </div>
              <div class="product-form__item product-form__item--submit">
                {% if product.available == false %}
                <a href="javascript: void(0)" class="addToCart  sold-out enable btn">
                  <span class="value">
                    {{ 'products.product.sold_out' | t }}
                  </span>
                </a>
                {% elsif product.variants[1] != blank %}
                <a href="javascript: void(0)" class="qv-addToCart addToCart enable btn">

                  <span class="value instock">
                    {{ 'products.product.add_to_cart' | t }}
                  </span>
                  <span class="value outstock">
                    {{ 'products.product.sold_out' | t }}
                  </span>
                  <span class="adding">
                    {{ 'products.product.adding' | t }}
                  </span>
                </a>
                {% else %}
                <a href="javascript: void(0)" class="qv-addToCart addToCart enable btn">
                  <span class="value instock">
                    {{ 'products.product.add_to_cart' | t }}
                  </span>
                  <span class="adding">
                    {{ 'products.product.adding' | t }}
                  </span>
                </a>
                {% endif %}
              </div>
              <input type="hidden" name="return_to" value="back" />
            </form>
          </div>
          <div class="nm-cartmain add_to_cart_main grid-cart">
            <form action="/cart/add" method="post" class="add-to-cart product-form product-form-{{ section.id }}" data-section="{{ section.id }}">

              <select title="Add to cart" name="prduct-variant" data-section="{{ section.id }}" class="product-form__variants no-js">

                {% for variant in product.variants %}
                <option {% if variant==product.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}" data-available="{% if variant.available %}1{% else %}0{% endif %}" {% unless variant.available %}disabled="disabled" {% endunless %}>{{ variant.title | escape | strip_html |
                  strip_newlines}}</option>
                {% endfor %}
              </select>
              {% for variant in product.variants %}
              {% if variant == product.selected_or_first_available_variant %}
              <input type="text" name="prduct-variant" value="{{ variant.id }}" class="product-form__input">
              {% endif %}
              {% endfor %}
              <input type="number" name="product-quantity" value="1" min="1" class="product-form__input">

              <div class="product-form__item product-form__item--submit">
                {% if product.available == false %}
                <a href="{{ product.url | within: collection }}" class="addToCart sold-out enable btn">
                  {% render 'icons' with 'addtocart' %}
                  <span class="value">
                    {{ 'products.product.sold_out' | t }}
                  </span>
                </a>
                {% else %}
                <a href="javascript: void(0)" class="nm-addToCart addToCart enable btn">
                  {% render 'icons' with 'addtocart' %}
                  <span class="value">
                    {{ 'products.product.add_to_cart' | t }}
                  </span>
                </a>
                {% endif %}
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <noscript>
      {% capture image_size %}{{ max_height }}x{{ max_height }}{% endcapture %}
      <img loading="lazy" class="grid-view-item__image" src="{{ product.featured_image.src | img_url: image_size, scale: 2 }}" alt="{{ product.featured_image.alt }}" style="max-width: {{ max_height | times: product.featured_image.aspect_ratio }}px;">
    </noscript>
  </div>
</div>

<script>
  ((
    product = {{ product | json }},
    collection = {{ collection | json }},
    productCollectionsTitles = {{ product.collections | map: 'title' | json}},
    initialVariant = {{ product.selected_or_first_available_variant | json }},
    soldOut = "{{ 'products.product.sold_out' | t }}",
    backOrder = "{{ 'products.product.back_order' | t }}",
    preOrder = "PREORDER"
  ) => {

    const variantsInventoryPolicy = {
    {% for variant in product.variants %}
    "{{variant.id}}" : "{{ variant.inventory_policy}}",
      {% endfor %}
  };

  const variantsInventoryQty = {
    {% for variant in product.variants %}
  "{{variant.id}}" : "{{ variant.inventory_quantity}}",
    {% endfor %}
  };

  const productContainers = document.querySelectorAll(`.product-${product.id}`);
  productContainers.forEach(container => {
    const variantSelect = container.querySelector('#ProductSelect-Dropdown');
    const tagContainer = container.querySelector('#tag-container');

    const setVariantStatus = (curVariantId = initialVariant.id) => {
      const selectedVariant = product.variants.filter(variant => variant.id === curVariantId)[0];
      const selectedVariantQty = variantsInventoryQty[selectedVariant.id];
      const selectedVariantInventoryPolicy = variantsInventoryPolicy[selectedVariant.id];
      let tagText;
      let tagClass;
      if (selectedVariant.available === false) {
        tagText = soldOut;
        tagClass = 'outstock-overlay';
      } else if (
        collection?.title.includes('pre-order') ||
        collection?.title.includes('preorder') ||
        productCollectionsTitles.some(title => title.includes('pre-order')) ||
        productCollectionsTitles.some(title => title.includes('preorder')) ||
        product.tags.includes('preorder')
      ) {
        tagText = preOrder;
        tagClass = 'preorder-overlay';
      } else if (
        product.type !== 'Event Ticket' && selectedVariantQty <= 0 && selectedVariantInventoryPolicy === 'continue'
      ) {
        tagText = backOrder;
        tagClass = 'backorder-overlay';
      } else {
        tagClass = 'hidden';
      }
      tagContainer.innerText = tagText;
      tagContainer.className = tagClass;
    };

    variantSelect?.addEventListener('change', (e) => {
      setVariantStatus(parseInt(e.target.value));
    });

    setVariantStatus();
  });
  }) ();
</script>